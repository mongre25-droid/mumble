---
import Logo from './Logo.astro';
import release from '../data/release.json';
import { requireLinkedReleaseResource } from '../data/release-resources.mjs';

const sourceResource = requireLinkedReleaseResource('source');
const licenceResource = requireLinkedReleaseResource('licence');
const supportResource = requireLinkedReleaseResource('support', 'available');
---

<footer class="site-footer" data-site-footer>
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand-link" href="/" aria-label="Mumble home"><Logo /></a>
      <p>A local-first desktop voice workspace for useful work, not an online account.</p>
      <p class="footer-state"><span aria-hidden="true"></span>{release.publication.label}</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <div>
        <h2>Explore</h2>
        <a href="/">Home</a>
        <a href="/product/">Product</a>
        <a href="/use-cases/">Use Cases</a>
        <a href="/#jobs">Five jobs</a>
        <a href="/privacy/">Privacy</a>
        <a href="/downloads/">Downloads</a>
        <a href="/help/">Help</a>
      </div>
      <div>
        <h2>Trust</h2>
        <a href="/privacy/">Privacy boundaries</a>
        <a href={licenceResource.href}>{licenceResource.label}</a>
        <span>Zero-CDN website</span>
      </div>
      <div>
        <h2>Project</h2>
        <a href={sourceResource.href}>Repository</a>
        <a href={supportResource.href}>{supportResource.label}</a>
        <span>{release.channel.label}</span>
      </div>
    </nav>
  </div>

  <div class="shell footer-meta">
    <span>© <span data-current-year>2026</span> Mumble</span>
    <span>Source version {release.version}</span>
    <span>Free · MIT licensed</span>
  </div>
</footer>
