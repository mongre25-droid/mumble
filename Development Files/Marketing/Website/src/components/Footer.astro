---
import Logo from './Logo.astro';
import { release } from '../data/release';
---

<footer class="site-footer" data-site-footer>
  <div class="container footer-main">
    <div class="footer-intro">
      <a class="brand-link" href="/" aria-label="Mumble home"><Logo /></a>
      <p>The private voice layer for everything you write.</p>
    </div>
    <div class="footer-links">
      <div>
        <h2>Product</h2>
        <a href="/#product">How it works</a>
        <a href="/#workflows">Workflows</a>
        <a href="/#download">Download</a>
      </div>
      <div>
        <h2>Trust</h2>
        <a href="/#privacy">Privacy architecture</a>
        <span>MIT licensed</span>
        <span>Repository link pending</span>
      </div>
      <div>
        <h2>Platforms</h2>
        <span>Windows · Available</span>
        <span>macOS · In development</span>
        <span>Linux · In development</span>
      </div>
    </div>
  </div>
  <div class="container footer-meta">
    <span>© <span data-current-year>2026</span> Mumble</span>
    <span>v{release.version} “{release.codename}”</span>
    <span class="status-line"><i></i> Local-first by default</span>
  </div>
</footer>
