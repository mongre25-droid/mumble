---
// WorkflowMeetings.astro — Meetings workflow section.
// Full flow: Record → Pause/Resume → Stop → Diarise → Summarise/Extract → Export.
// Both processing modes (lightweight & deep), visual mockup with recording controls,
// speaker labels, and action buttons. Outcome-focused headline.
---

<section class="section" id="meetings">
  <div class="container">

    <!-- ===== Section Head ===== -->
    <div class="section-head center">
      <span class="h-kicker center">Meetings</span>
      <h2 class="section-title reveal">Never type meeting notes again.</h2>
      <p class="section-lead reveal d1">
        Record up to four hours from your selected microphone, or import a WAV,
        MP3, FLAC, or OGG online-call recording. Then transcribe, add best-effort speaker labels, summarise, extract action
        items, replay the audio, and export it. Transcription is local by default;
        the optional Cloud mode follows the choice you make in Settings.
      </p>
    </div>

    <!-- ===== Flow Diagram: Record → Export ===== -->
    <div class="meet-flow reveal d2">
      <div class="card pad">
        <div class="flow-head">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
          </svg>
          <h3>The full meeting flow</h3>
        </div>

        <div class="flow-steps">
          <div class="fstep">
            <svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3" fill="currentColor"/>
            </svg>
            <div class="fnum">1</div>
            <h4>Record</h4>
            <p>Capture room audio from your microphone, or import WAV, MP3, FLAC, or OGG call audio.</p>
          </div>

          <div class="fstep">
            <svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>
            </svg>
            <div class="fnum">2</div>
            <h4>Pause / Resume</h4>
            <p>Pause any time, resume when ready.</p>
          </div>

          <div class="fstep">
            <svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="4" y="4" width="16" height="16" rx="2"/>
            </svg>
            <div class="fnum">3</div>
            <h4>Stop</h4>
            <p>End the session &mdash; transcription begins.</p>
          </div>

          <div class="fstep is-local">
            <svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
            </svg>
            <div class="fnum">4</div>
            <h4>Label speakers</h4>
            <p>Best-effort labels distinguish turns; accuracy can fall on long or Cloud-mode recordings.</p>
          </div>

          <div class="fstep">
            <svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
              <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
            <div class="fnum">5</div>
            <h4>Summarise &amp; Extract</h4>
            <p>AI summary, action items, key decisions, open questions.</p>
          </div>
        </div>

        <div class="flow-steps meet-flow-export">
          <div class="fstep">
            <svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <div class="fnum">6</div>
            <h4>Export</h4>
            <p>TXT, Markdown, JSON, HTML, or clipboard.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== Processing Modes ===== -->
    <div class="meet-modes reveal d3">
      <div class="meet-modes-grid">
        <!-- Lightweight -->
        <div class="card pad lift sheen">
          <div class="feature-ic" style="--fc:var(--gold)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <h3>Lightweight</h3>
          <p class="meet-mode-desc">
            Fast, summary-only processing. Get an AI-generated meeting summary
            in seconds &mdash; perfect for quick stand-ups, check-ins, and short
            calls where you just need the gist.
          </p>
          <div class="meet-mode-badges">
            <span class="chip-sm gold">Summary</span>
            <span class="chip-sm">Fast</span>
          </div>
        </div>

        <!-- Deep -->
        <div class="card pad lift sheen">
          <div class="feature-ic" style="--fc:var(--mode-prompt)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
          <h3>Deep</h3>
          <p class="meet-mode-desc">
            Comprehensive one-pass processing. You get a full summary
            <strong>plus</strong> extracted action items, key decisions, and open
            questions &mdash; ready to share with your team.
          </p>
          <div class="meet-mode-badges">
            <span class="chip-sm gold">Summary</span>
            <span class="chip-sm gold">Action items</span>
            <span class="chip-sm gold">Key decisions</span>
            <span class="chip-sm gold">Open questions</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== Visual Mockup: Meetings UI ===== -->
    <div class="meet-mockup reveal d4">
      <div class="meet-window">
        <!-- Window titlebar -->
        <div class="win-titlebar">
          <div class="brand">
            <div class="brand-row">
              <span class="brand-badge">
                <svg viewBox="0 0 24 24" fill="none">
                  <g stroke="#D4AF37" stroke-width="2.4" stroke-linecap="round">
                    <line x1="4" y1="10" x2="4" y2="14"/>
                    <line x1="8" y1="7" x2="8" y2="17"/>
                    <line x1="12" y1="4" x2="12" y2="20"/>
                    <line x1="16" y1="7" x2="16" y2="17"/>
                    <line x1="20" y1="10" x2="20" y2="14"/>
                  </g>
                </svg>
              </span>
              <span class="brand-name">Mumble</span>
            </div>
            <div class="win-status rec">
              <span class="sd"></span>
              <span class="st">Recording &middot; 04:32</span>
            </div>
          </div>
        </div>

        <!-- Recording controls -->
        <div class="meet-controls">
          <button class="meet-btn meet-btn-rec" aria-label="Pause recording">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>
            </svg>
            Pause
          </button>
          <button class="meet-btn meet-btn-stop" aria-label="Stop recording">
            <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="4" y="4" width="16" height="16" rx="2"/>
            </svg>
            Stop
          </button>
        </div>

        <!-- Mini waveform -->
        <div class="meet-waveform" aria-hidden="true">
          <span class="meet-wb" style="height:18px;--dur:0.9s"></span>
          <span class="meet-wb" style="height:32px;--dur:1.1s"></span>
          <span class="meet-wb" style="height:24px;--dur:0.85s"></span>
          <span class="meet-wb" style="height:38px;--dur:1.05s"></span>
          <span class="meet-wb" style="height:28px;--dur:0.95s"></span>
          <span class="meet-wb" style="height:42px;--dur:1.15s"></span>
          <span class="meet-wb" style="height:22px;--dur:0.8s"></span>
          <span class="meet-wb" style="height:36px;--dur:1.0s"></span>
          <span class="meet-wb" style="height:26px;--dur:0.92s"></span>
          <span class="meet-wb" style="height:44px;--dur:1.2s"></span>
          <span class="meet-wb" style="height:20px;--dur:0.88s"></span>
          <span class="meet-wb" style="height:34px;--dur:1.08s"></span>
        </div>

        <!-- Transcript with speaker labels -->
        <div class="meet-transcript">
          <div class="meet-segment">
            <span class="meet-speaker" style="--sp-c:var(--mode-email)">SPK 1</span>
            <span class="meet-text">Alright, let&rsquo;s go over the Q3 roadmap. We need to finalise the feature list before the sprint planning on Friday.</span>
          </div>
          <div class="meet-segment">
            <span class="meet-speaker" style="--sp-c:var(--mode-prompt)">SPK 2</span>
            <span class="meet-text">Agreed. I think the priority order should be: dictation polish, then the Deck search upgrade, then meetings export.</span>
          </div>
          <div class="meet-segment">
            <span class="meet-speaker" style="--sp-c:var(--mode-list)">SPK 3</span>
            <span class="meet-text">Can we also discuss the Reader? PDF rendering still needs work.</span>
          </div>
          <div class="meet-segment">
            <span class="meet-speaker" style="--sp-c:var(--mode-email)">SPK 1</span>
            <span class="meet-text">Good point &mdash; let&rsquo;s add that as an agenda item for next week.</span>
          </div>
        </div>

        <!-- Action buttons -->
        <div class="meet-actions">
          <button class="btn btn-outline-gold btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            Summarise
          </button>
          <button class="btn btn-outline-gold btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 10 4 15 9 20"/><path d="M20 4v7a4 4 0 01-4 4H4"/>
            </svg>
            Extract
          </button>
          <button class="btn btn-gold btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Export
          </button>
        </div>
      </div>
    </div>

    <!-- ===== Export Formats + CTA ===== -->
    <div class="meet-export reveal d5">
      <div class="card pad" style="text-align:center;">
        <h3 style="font-size:1.22rem;margin-bottom:12px;">Export exactly how you need it</h3>
        <div class="meet-formats">
          <span class="chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--text-dim)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/>
            </svg>
            TXT
          </span>
          <span class="chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--text-dim)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="4 7 12 5 20 7"/><line x1="12" y1="5" x2="12" y2="19"/>
              <polyline points="4 13 12 12 20 13"/>
            </svg>
            Markdown
          </span>
          <span class="chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--text-dim)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 17V7a2 2 0 012-2h1l2-3h6l2 3h1a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2z"/>
            </svg>
            JSON
          </span>
          <span class="chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--text-dim)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
            </svg>
            HTML
          </span>
          <span class="chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--text-dim)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
            </svg>
            Clipboard
          </span>
        </div>

        <p style="color:var(--text-mute);font-size:.9rem;margin-top:16px;">
          Meetings are saved to your local Mumble store and remain available for replay and re-export.
        </p>

        <div style="margin-top:28px;">
          <a class="btn btn-gold btn-lg" href="#download">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
            </svg>
            Download Mumble &mdash; Free
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* ===== Meetings Flow ===== */
  .meet-flow { margin-top: 52px; }
  .meet-flow .flow-steps { grid-template-columns: repeat(5, 1fr); }
  .meet-flow-export { margin-top: 12px; grid-template-columns: 1fr; max-width: 320px; }

  /* ===== Processing Modes ===== */
  .meet-modes { margin-top: 48px; }
  .meet-modes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  .meet-mode-desc {
    color: var(--text-dim);
    font-size: .96rem;
    line-height: 1.6;
    margin-top: 2px;
  }
  .meet-mode-desc strong { color: var(--text); font-weight: 600; }
  .meet-mode-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
  }

  /* ===== Visual Mockup ===== */
  .meet-mockup {
    margin-top: 56px;
    display: flex;
    justify-content: center;
  }
  .meet-window {
    position: relative;
    width: 100%;
    max-width: 680px;
    border-radius: var(--r-xl);
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 40% at 50% 0%, rgba(212,175,55,.04), transparent 60%),
      var(--glass-grad);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg), var(--glass-hi), var(--glass-lo);
  }
  .meet-window .win-titlebar {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22px 20px 8px;
  }
  .meet-window .win-titlebar .brand {
    flex-direction: column;
    gap: 5px;
    align-items: center;
  }
  .meet-window .win-titlebar .brand-row {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .meet-window .brand-badge {
    width: 28px;
    height: 28px;
    border-radius: 9px;
  }
  .meet-window .brand-badge svg { width: 16px; height: 16px; }
  .meet-window .brand-name { font-size: 1.05rem; }
  .meet-window .win-status {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .meet-window .win-status .sd {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
    animation: pulse 1.4s ease-in-out infinite;
  }
  .meet-window .win-status .st {
    font-size: .7rem;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Recording controls */
  .meet-controls {
    display: flex;
    justify-content: center;
    gap: 12px;
    padding: 10px 20px 16px;
    border-bottom: 1px solid var(--border-soft);
  }
  .meet-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: var(--r-md);
    font-size: .88rem;
    font-weight: 600;
    transition: background .18s, transform .15s var(--ease-spring);
  }
  .meet-btn svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }
  .meet-btn:hover {
    transform: translateY(-1px);
  }
  .meet-btn-rec {
    color: var(--text);
    background: var(--elevated);
    border: 1px solid var(--border);
  }
  .meet-btn-rec:hover {
    background: var(--elevated-2);
    border-color: rgba(212,175,55,.26);
  }
  .meet-btn-stop {
    color: #fff;
    background: rgba(217,84,77,.18);
    border: 1px solid rgba(217,84,77,.35);
  }
  .meet-btn-stop:hover {
    background: rgba(217,84,77,.3);
    border-color: var(--red);
  }

  /* Mini waveform */
  .meet-waveform {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    height: 60px;
    padding: 0 20px;
  }
  .meet-wb {
    width: 3px;
    border-radius: 999px;
    background: var(--gold);
    transform-origin: center;
    animation: meetWave var(--dur, 1s) ease-in-out infinite;
  }
  @keyframes meetWave {
    0%   { transform: scaleY(.25); opacity: .35; }
    50%  { transform: scaleY(1);   opacity: .95; }
    100% { transform: scaleY(.25); opacity: .35; }
  }

  /* Transcript with speaker labels */
  .meet-transcript {
    padding: 20px;
    display: grid;
    gap: 14px;
  }
  .meet-segment {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .meet-speaker {
    flex: 0 0 auto;
    width: 44px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .04em;
    color: #1A1407;
    background: var(--sp-c, var(--gold));
    margin-top: 1px;
  }
  .meet-text {
    font-size: .9rem;
    color: var(--text-dim);
    line-height: 1.55;
    flex: 1;
    min-width: 0;
  }

  /* Action buttons */
  .meet-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    padding: 6px 20px 26px;
  }
  .meet-actions .btn {
    font-size: .86rem;
  }

  /* ===== Export Formats ===== */
  .meet-export { margin-top: 48px; }
  .meet-formats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
  }

  /* ===== Responsive ===== */
  @media (max-width: 1040px) {
    .meet-flow .flow-steps { grid-template-columns: repeat(3, 1fr); }
    .meet-flow .flow-steps .fstep:last-child { grid-column: span 1; }
    .meet-flow-export { max-width: none; grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .meet-modes-grid { grid-template-columns: 1fr; }
    .meet-flow .flow-steps { grid-template-columns: 1fr 1fr; }
    .meet-window .meet-controls { flex-direction: column; align-items: stretch; }
    .meet-btn { justify-content: center; }
  }
  @media (max-width: 480px) {
    .meet-flow .flow-steps { grid-template-columns: 1fr; }
    .meet-segment { flex-direction: column; gap: 6px; }
  }
</style>
