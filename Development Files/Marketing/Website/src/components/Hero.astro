---
import { statSync } from 'node:fs';
import { resolve } from 'node:path';
import { release } from '../data/release';

const archiveSizeKb = Math.round(
  statSync(resolve(process.cwd(), 'public', 'Mumble.zip')).size / 1000,
).toLocaleString('en-GB');
---

<section class="hero" id="hero">
  <div class="hero-grid-lines" aria-hidden="true"></div>
  <div class="container hero-layout">
    <div class="hero-copy">
      <p class="eyebrow reveal"><span></span>Private voice-to-text for Windows</p>
      <h1 class="reveal delay-1">
        <span>The voice layer</span>
        <span>for everything</span>
        <span class="text-gold">you write.</span>
      </h1>
      <p class="hero-lead reveal delay-2">
        Press one hotkey, speak naturally, and Mumble turns it into clean text
        in any app—transcribed on your PC by default.
      </p>

      <div class="hero-actions reveal delay-3">
        <a class="button button-gold button-large" href={release.downloadPath} download>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" />
          </svg>
          Download for Windows
        </a>
        <a class="text-link" href="#product">
          See Mumble in action
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
        </a>
      </div>

      <div class="release-line reveal delay-4" aria-label="Release information">
        <span>v{release.version}</span>
        <span>{archiveSizeKb} KB ZIP</span>
        <span>Windows 10+</span>
        <span>Free</span>
        <span>No account required</span>
      </div>
    </div>

    <figure class="hero-product reveal delay-2">
      <div class="product-frame">
        <div class="frame-bar" aria-hidden="true">
          <span class="frame-dots"><i></i><i></i><i></i></span>
          <span>mumble · home</span>
          <span class="frame-status"><i></i> local</span>
        </div>
        <img
          src="/product/home.webp"
          width="1180"
          height="820"
          alt="Mumble home screen showing its voice-first workspace and local transcription controls"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="hero-island" aria-hidden="true">
        <span class="island-live"></span>
        <span class="mini-wave">
          <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
        </span>
        <strong>Listening</strong>
      </div>

      <figcaption>
        <span>Mumble / Home</span>
        One voice-first workspace for dictation, meetings, reading, and AI.
      </figcaption>
    </figure>
  </div>

  <div class="container proof-rail reveal">
    <div><span>01</span><strong>Local by default</strong><small>Audio stays on your PC in Local mode.</small></div>
    <div><span>02</span><strong>Works in any app</strong><small>Clean text lands at your cursor.</small></div>
    <div><span>03</span><strong>No account required</strong><small>Download, set up, and keep your data yours.</small></div>
    <div><span>04</span><strong>AI is optional</strong><small>Local dictation needs no provider.</small></div>
  </div>
</section>
