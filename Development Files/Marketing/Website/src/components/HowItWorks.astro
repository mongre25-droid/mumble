---
// HowItWorks.astro — How It Works section with outcome-focused copy.
// 3-step horizontal strip + under-the-hood flow diagram.
// Fulfills VAL-CONTENT-003 and VAL-CONTENT-004.
---

<section class="section" id="how">
  <div class="container">
    <!-- ===== Section heading ===== -->
    <div class="section-head center reveal">
      <span class="h-kicker center">How it works</span>
      <h2 class="section-title">Three steps from voice to text.</h2>
      <p class="section-lead">
        No training, no setup, no complexity. Just talk and get clean
        text wherever you&rsquo;re writing.
      </p>
    </div>

    <!-- ===== 3-step horizontal strip ===== -->
    <div class="how-strip">
      <!-- Step 1 -->
      <div class="how-step reveal">
        <span class="how-n">1</span>
        <div>
          <h3>Press the hotkey</h3>
          <p>
            From any app &mdash; your email, chat, or document. The
            floating island appears instantly as your cue that Mumble
            is listening.
          </p>
          <span class="kbd">Ctrl + Win</span>
        </div>
      </div>

      <div class="how-line" aria-hidden="true"></div>

      <!-- Step 2 -->
      <div class="how-step reveal d1">
        <span class="how-n">2</span>
        <div>
          <h3>Speak naturally</h3>
          <p>
            Talk in full sentences like you would to a person. Mumble
            handles punctuation, capitals, and cleanup automatically
            &mdash; all on your device.
          </p>
        </div>
      </div>

      <div class="how-line" aria-hidden="true"></div>

      <!-- Step 3 -->
      <div class="how-step reveal d2">
        <span class="how-n">3</span>
        <div>
          <h3>Text pasted, shaped</h3>
          <p>
            Press again. Clean, polished text lands right where you were
            typing. Every transcript is also saved to your Deck for
            later.
          </p>
        </div>
      </div>
    </div>

    <!-- ===== Under-the-hood flow diagram ===== -->
    <div class="flow-rail reveal d3">
      <div class="card sheen">
        <div class="flow-head">
          <span class="h-kicker">Under the hood</span>
          <h3>Your words, processed locally</h3>
        </div>

        <div class="flow-steps how-flow-steps">
          <!-- 1. Audio -->
          <div class="fstep">
            <div class="fic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="3" width="6" height="11" rx="3"/>
                <path d="M5 11a7 7 0 0014 0M12 18v3"/>
              </svg>
            </div>
            <span class="fnum">1</span>
            <h4>Your audio</h4>
            <p>Press the hotkey and start speaking from any app.</p>
            <span class="flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>

          <!-- 2. Transcription (local) -->
          <div class="fstep is-local">
            <div class="fic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 5h14M5 10h14M5 15h9"/>
              </svg>
            </div>
            <span class="fnum">2</span>
            <h4>Local transcription</h4>
            <p>By default, faster-whisper runs locally and audio stays on your device.</p>
            <span class="flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>

          <!-- 3. AI polish (optional) -->
          <div class="fstep">
            <div class="fic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l1.6 4L18 8.5l-4.4 1.5L12 14l-1.6-4L6 8.5 10.4 7 12 3z"/>
              </svg>
            </div>
            <span class="fnum">3</span>
            <h4>AI polish</h4>
            <p>Optional. Smart Modes shape the text; your AI provider refines it.</p>
            <span class="flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>

          <!-- 4. Output -->
          <div class="fstep">
            <div class="fic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14m0 0l-5-5m5 5l-5 5"/>
              </svg>
            </div>
            <span class="fnum">4</span>
            <h4>Pasted at your cursor</h4>
            <p>Clean, shaped text lands where you were typing. Saved to the Deck.</p>
          </div>
        </div>

        <div class="flow-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6l7-3z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
          <span><strong>Local mode keeps audio on your device.</strong> Pro Mode sends only transcribed text. Cloud Transcription is a separate, explicit opt-in that sends audio to the provider you configure.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Override flow-steps grid to use 4 columns instead of 5,
     matching our 4-stage pipeline: audio → transcription → AI → output */
  .how-flow-steps {
    grid-template-columns: repeat(4, 1fr);
  }

  /* Ensure the last fstep doesn't have an overflow arrow */
  .how-flow-steps .fstep:last-child .flow-arrow {
    display: none;
  }
</style>
