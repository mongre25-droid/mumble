---
import jobs from '../data/jobs.json';
import { projectHomeMontage } from '../data/home-montage.mjs';

type HomeMontageStep = {
  id: string;
  label: string;
  action: string;
  title: string;
  body: string;
  evidence: string;
  media: { src: string; width: number; height: number; alt: string };
  routeLabel?: string;
  route?: string[];
};

const steps = projectHomeMontage(jobs) as HomeMontageStep[];
const guidedJobList = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' })
  .format(steps.map((step) => step.label));
---

<section
  class="home-montage"
  data-home-montage
  data-home-step="1"
  data-home-state="manual"
  data-home-pass-count="0"
  aria-label={`${guidedJobList} guided product tour`}
>
  <header class="home-montage-bar">
    <strong>Mumble workspace</strong>
    <span aria-live="polite" data-home-status>Guided pass ready</span>
  </header>

  <div class="home-montage-panels">
    {steps.map((step, index) => (
      <article
        class="home-montage-panel"
        data-home-panel={step.id}
        data-active={index === 0 ? '' : undefined}
        role="tabpanel"
        id={`home-montage-panel-${step.id}`}
        aria-labelledby={`home-montage-tab-${step.id}`}
        tabindex="0"
      >
        <div class="home-montage-copy">
          <span>{step.label}</span>
          <h2 id={`home-montage-${step.id}`}>{step.title}</h2>
          <p>{step.action}</p>
          <small>{step.body}</small>
          {step.route && (
            <ol class="home-shape-route" aria-label={step.routeLabel}>
              {step.route.map((item) => <li>{item}</li>)}
            </ol>
          )}
        </div>
        <figure>
          <img src={step.media.src} width={step.media.width} height={step.media.height} alt={step.media.alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
          <figcaption>{step.evidence}</figcaption>
        </figure>
      </article>
    ))}
  </div>

  <div class="home-montage-controls" data-home-controls>
    <div class="home-step-tabs" role="tablist" aria-label="Choose a Mumble job">
      {steps.map((step, index) => (
        <button
          type="button"
          role="tab"
          id={`home-montage-tab-${step.id}`}
          data-home-step-select={index + 1}
          aria-controls={`home-montage-panel-${step.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          {step.label}: {step.action}
        </button>
      ))}
    </div>
    <div class="home-transport" aria-label="Guided tour controls">
      <button type="button" data-home-previous>Previous</button>
      <button type="button" data-home-next>Next</button>
      <button type="button" data-home-play>Play</button>
      <button type="button" data-home-pause>Pause</button>
    </div>
  </div>
</section>
