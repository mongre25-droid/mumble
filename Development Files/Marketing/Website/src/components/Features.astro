---
// Features.astro — Bento grid showcasing all primary and secondary features.
// Primary cards (span 2): Dictation, Meetings, Deck, Reader, Smart Modes, Pro Mode.
// Secondary cards (span 1): Web Search, Capture+Clipboard, Foreign Mode, Stats, Presets.
// All cards use glass styling with resting sheen + hover sweep animation.
// All copy verified against Internal/README.md. No defensive language.
---

<section class="section" id="inside">
  <div class="container">
    <div class="section-head center reveal">
      <span class="h-kicker center">What's inside Mumble</span>
      <h2 class="section-title">Everything you need to work at the speed of voice</h2>
      <p class="section-lead">
        From quick dictation to meeting intelligence, Mumble gives you a full
        toolkit &mdash; all running locally on your machine.
      </p>
    </div>

    <div class="bento">

      <!-- ============================================================ -->
      <!-- PRIMARY CARDS (span 2)                                       -->
      <!-- ============================================================ -->

      <!-- 1. Dictation -->
      <div class="bento-item span2 card pad lift sheen reveal d1">
        <div class="feature-ic" style="--fc:var(--gold)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 1a3 3 0 00-3 3v6a3 3 0 006 0V4a3 3 0 00-3-3z"/>
            <path d="M19 9v1a7 7 0 01-14 0V9"/>
            <line x1="12" y1="18" x2="12" y2="22"/>
            <line x1="9" y1="22" x2="15" y2="22"/>
          </svg>
        </div>
        <h3>Push-to-Talk Dictation</h3>
        <p>
          Tap <strong>Ctrl + Win</strong> to start, speak naturally, tap again.
          Your words are transcribed locally and pasted wherever your cursor is
          &mdash; emails, chats, documents, anywhere you type.
          A small floating island shows you what's happening.
        </p>
        <span class="kbd">Ctrl + Win</span>
        <!-- mini waveform visual -->
        <div class="feature-demo">
          <div class="waveform" aria-hidden="true" style="height:44px;gap:3px;justify-content:flex-start">
            <span class="wb wv-a" style="height:18px;--dur:0.9s"></span>
            <span class="wb wv-b" style="height:32px;--dur:1.1s"></span>
            <span class="wb wv-c" style="height:24px;--dur:0.8s"></span>
            <span class="wb wv-d" style="height:38px;--dur:1.2s"></span>
            <span class="wb wv-e" style="height:20px;--dur:1.0s"></span>
            <span class="wb wv-a" style="height:35px;--dur:0.85s"></span>
            <span class="wb wv-b" style="height:15px;--dur:1.05s"></span>
            <span class="wb wv-c" style="height:40px;--dur:0.95s"></span>
            <span class="wb wv-d" style="height:22px;--dur:1.15s"></span>
            <span class="wb wv-e" style="height:33px;--dur:0.78s"></span>
          </div>
        </div>
      </div>

      <!-- 2. Meetings (CRITICAL — previously missing) -->
      <div class="bento-item span2 card pad lift sheen reveal d1">
        <div class="feature-ic" style="--fc:var(--mode-prompt)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <circle cx="12" cy="12" r="4"/>
            <line x1="12" y1="2" x2="12" y2="6"/>
            <line x1="12" y1="18" x2="12" y2="22"/>
            <line x1="2" y1="12" x2="6" y2="12"/>
            <line x1="18" y1="12" x2="22" y2="12"/>
          </svg>
        </div>
        <h3>Meeting Mode</h3>
        <p>
          Turn Mumble into a meeting recorder. Click <strong>Record</strong>,
          pause and resume any time, then stop. Mumble transcribes locally and
          runs <strong>speaker diarisation</strong> so each segment is tagged.
          Summarise, extract action items and key decisions, then export to
          TXT, Markdown, JSON, HTML, or clipboard. Two processing modes:
          <strong>lightweight</strong> (summary-only) and <strong>deep</strong>
          (summary + action items + key decisions + open questions).
        </p>
        <!-- mini meeting flow -->
        <div class="feature-demo">
          <div class="chip-row">
            <span class="chip-sm gold">Record</span>
            <span class="chip-sm">Pause</span>
            <span class="chip-sm">Stop</span>
            <span class="chip-sm gold">Diarise</span>
            <span class="chip-sm gold">Summarise</span>
            <span class="chip-sm">Extract</span>
            <span class="chip-sm gold">Export</span>
          </div>
        </div>
      </div>

      <!-- 3. Deck -->
      <div class="bento-item span2 card pad lift sheen reveal d2">
        <div class="feature-ic" style="--fc:var(--mode-list)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/>
          </svg>
        </div>
        <h3>The Deck <span class="kbd dim">Ctrl + Alt + D</span></h3>
        <p>
          Your mini dashboard of everything you've made and copied: transcripts,
          clipboard history, and saved prompts in one searchable, always-pinned
          list. Pick a preset and a Smart Mode, tick some items, and press
          <strong>Go</strong> &mdash; the result pastes where you were typing.
          Pinned by default, the Deck floats on top without ever stealing focus.
        </p>
        <!-- mini Deck rows -->
        <div class="feature-demo">
          <div class="deck-mock">
            <div class="deck-row">
              <div class="dr-main">
                <div class="dr-meta">
                  <span class="mode-dot" style="background:var(--mode-email)"></span>
                  <span class="tag" style="color:var(--mode-email);background:color-mix(in srgb,var(--mode-email) 14%,transparent)">Email</span>
                  <span>Today &middot; 2:14pm</span>
                </div>
                <div class="dr-text">Hi Sarah, thanks for the quick turnaround — let's ship Friday as planned.</div>
              </div>
              <span class="star on">&#9733;</span>
            </div>
            <div class="deck-row">
              <div class="dr-main">
                <div class="dr-meta">
                  <span class="mode-dot" style="background:var(--gold)"></span>
                  <span class="tag" style="color:var(--gold);background:color-mix(in srgb,var(--gold) 14%,transparent)">Text</span>
                  <span>Today &middot; 11:42am</span>
                </div>
                <div class="dr-text">Mumble is a private, on-device voice-to-text app for Windows.</div>
              </div>
              <span class="star">&#9733;</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Reader -->
      <div class="bento-item span2 card pad lift sheen reveal d2">
        <div class="feature-ic" style="--fc:var(--mode-email)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 3h7a2 2 0 012 2v14a2 2 0 01-2 2H2V3z"/>
            <path d="M15 3h7v18h-7z"/>
            <line x1="6" y1="8" x2="6" y2="8.01"/>
            <line x1="9" y1="8" x2="9" y2="8.01"/>
            <line x1="6" y1="12" x2="6" y2="12.01"/>
            <line x1="9" y1="12" x2="9" y2="12.01"/>
          </svg>
        </div>
        <h3>Reader</h3>
        <p>
          Open and read documents in-app with text-to-speech playback.
          Supports PDF, DOCX, EPUB, HTML, RTF, Markdown, TXT, CSV, ODT, PPTX,
          and XLSX. Watch each word light up in gold as it's spoken aloud.
          A full library tracks your reading progress across documents.
        </p>
        <!-- mini reader demo -->
        <div class="feature-demo reader-mini">
          <p class="reader-text" aria-hidden="true">
            <span class="w spoken">Mumble</span>
            <span class="w"> is</span>
            <span class="w"> a</span>
            <span class="w"> private</span>
            <span class="w"> voice-to-text</span>
            <span class="w"> app</span>
            <span class="w"> that</span>
            <span class="w"> runs</span>
            <span class="w"> on</span>
            <span class="w"> your</span>
            <span class="w"> machine.</span>
          </p>
          <div class="reader-controls">
            <span class="play">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6,3 20,12 6,21"/></svg>
            </span>
            <span class="track-line"></span>
          </div>
        </div>
      </div>

      <!-- 5. Smart Modes -->
      <div class="bento-item span2 card pad lift sheen reveal d3">
        <div class="feature-ic" style="--fc:var(--mode-foreign)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13,2 3,14 12,14 11,22 21,10 12,10 13,2"/>
          </svg>
        </div>
        <h3>Smart Modes</h3>
        <p>
          <strong>Toggle a mode on the Island Deck</strong> before you dictate
          to shape your output on the fly. Five armable modes:
          <strong>Text</strong> (clean dictation, always armed),
          <strong>Prompt</strong> (structured AI prompt &mdash; sticky toggle),
          <strong>Email</strong>, <strong>Reply</strong> (to highlighted text),
          and <strong>Foreign</strong> (preserves non-English).
          The Island shows which mode is active so you always know.
        </p>
        <!-- mode chips visual -->
        <div class="feature-demo">
          <div class="mode-chips">
            <span class="mode-chip" style="--c:var(--mode-text)">Text</span>
            <span class="mode-chip" style="--c:var(--mode-prompt)">Prompt</span>
            <span class="mode-chip on" style="--c:var(--mode-email)">Email</span>
            <span class="mode-chip" style="--c:var(--mode-reply)">Reply</span>
            <span class="mode-chip" style="--c:var(--mode-foreign)">Foreign</span>
          </div>
          <p class="shift-note" style="margin-top:10px;text-align:left">Toggle a mode on the Island Deck before you dictate</p>
        </div>
      </div>

      <!-- 6. Pro Mode / BYO AI -->
      <div class="bento-item span2 card pad lift sheen reveal d3">
        <div class="feature-ic" style="--fc:var(--mode-reply)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.86L12 17.77 6.82 21 8 14.14 3 9.27 8.91 8.26 12 2z"/>
          </svg>
        </div>
        <h3>Pro Mode &mdash; Bring Your Own AI</h3>
        <p>
          Optional AI polish using <strong>your own keys</strong>. Choose from
          Cerebras, OpenAI, Anthropic, DeepSeek, Groq, or run a local model on
          your machine. Only transcribed <strong>text</strong> is sent to your
          provider &mdash; not your audio. Cloud Transcription is a separate opt-in;
          with it off, disabling Pro Mode keeps dictation fully offline.
        </p>
        <!-- provider chips -->
        <div class="feature-demo">
          <div class="provider-grid" style="grid-template-columns:repeat(6,1fr);gap:8px">
            <div class="provider" style="padding:12px 8px;gap:6px">
              <span class="pv-name" style="font-size:.78rem">Cerebras</span>
            </div>
            <div class="provider" style="padding:12px 8px;gap:6px">
              <span class="pv-name" style="font-size:.78rem">OpenAI</span>
            </div>
            <div class="provider" style="padding:12px 8px;gap:6px">
              <span class="pv-name" style="font-size:.78rem">Anthropic</span>
            </div>
            <div class="provider" style="padding:12px 8px;gap:6px">
              <span class="pv-name" style="font-size:.78rem">DeepSeek</span>
            </div>
            <div class="provider" style="padding:12px 8px;gap:6px">
              <span class="pv-name" style="font-size:.78rem">Groq</span>
            </div>
            <div class="provider local" style="padding:12px 8px;gap:6px">
              <span class="pv-name" style="font-size:.78rem">Local</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- SECONDARY CARDS (span 1) — compact, consolidated             -->
      <!-- ============================================================ -->

      <!-- 7. Web Search -->
      <div class="bento-item card pad lift sheen reveal d4">
        <div class="feature-ic" style="--fc:var(--amber);width:40px;height:40px;border-radius:11px;margin-bottom:14px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:20px;height:20px">
            <circle cx="11" cy="11" r="7"/>
            <line x1="16.5" y1="16.5" x2="21" y2="21"/>
          </svg>
        </div>
        <h3>Web Search</h3>
        <p>
          Highlight text anywhere and press
          <strong>Ctrl + Alt + S</strong> to search the web instantly.
        </p>
        <span class="kbd dim">Ctrl + Alt + S</span>
      </div>

      <!-- 8. Capture + Clipboard -->
      <div class="bento-item card pad lift sheen reveal d4">
        <div class="feature-ic" style="--fc:var(--mode-convert);width:40px;height:40px;border-radius:11px;margin-bottom:14px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:20px;height:20px">
            <rect x="8" y="2" width="8" height="4" rx="1"/>
            <path d="M16 4h2a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/>
            <line x1="12" y1="11" x2="12" y2="17"/>
            <line x1="9" y1="14" x2="15" y2="14"/>
          </svg>
        </div>
        <h3>Capture + Clipboard</h3>
        <p>
          Highlight text in any app and click <strong>Capture</strong> in the
          Deck to pull it in. Clipboard history is tracked automatically.
        </p>
      </div>

      <!-- 9. Foreign Mode -->
      <div class="bento-item card pad lift sheen reveal d4">
        <div class="feature-ic" style="--fc:var(--mode-foreign);width:40px;height:40px;border-radius:11px;margin-bottom:14px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:20px;height:20px">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
          </svg>
        </div>
        <h3>Foreign Mode</h3>
        <p>
          Non-English terms are preserved and resolved correctly, prioritising
          the languages you pick in Settings.
        </p>
      </div>

      <!-- 10. Stats -->
      <div class="bento-item card pad lift sheen reveal d4">
        <div class="feature-ic" style="--fc:var(--green);width:40px;height:40px;border-radius:11px;margin-bottom:14px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:20px;height:20px">
            <line x1="18" y1="20" x2="18" y2="10"/>
            <line x1="12" y1="20" x2="12" y2="4"/>
            <line x1="6" y1="20" x2="6" y2="14"/>
          </svg>
        </div>
        <h3>Stats Dashboard</h3>
        <p>
          Track total words, dictations, time saved, streaks, and trends.
          Includes a 13-week activity heatmap and Smart Mode mix breakdown.
        </p>
      </div>

      <!-- ============================================================ -->
      <!-- 11. Presets (span 2, smaller card for balance)               -->
      <!-- ============================================================ -->

      <div class="bento-item span2 card pad lift sheen reveal d5">
        <div class="feature-ic" style="--fc:var(--gold);margin-bottom:14px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2v16z"/>
          </svg>
        </div>
        <h3>AI Presets &mdash; 17 built-in + 3 custom = 20</h3>
        <p>
          Pick from 17 built-in AI presets (Summarise, Improve, Reply,
          Action Items, Expand, and more) plus 3 custom slots you define.
          Combine with any Smart Mode, tick items in the Deck, and press Go.
        </p>
        <div class="feature-demo">
          <div class="preset-cloud">
            <span class="pp">Summarise</span>
            <span class="pp">Action Items</span>
            <span class="pp">Improve</span>
            <span class="pp">Reply</span>
            <span class="pp">Expand</span>
            <span class="pp">Key Points</span>
            <span class="pp">Fix Errors</span>
            <span class="pp more">+13 more</span>
          </div>
        </div>
      </div>

    </div><!-- .bento -->
  </div>
</section>

<script>
  import '../scripts/demos.js';
</script>
