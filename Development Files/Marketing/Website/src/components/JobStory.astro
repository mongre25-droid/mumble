---
import jobs from '../data/jobs.json';

type Job = (typeof jobs)[number];
type StorySurface = 'home' | 'product' | 'use-cases';

export interface Props {
  job: Job;
  surface: StorySurface;
}

const { job, surface } = Astro.props;
if (!job.story) throw new Error(`${job.label} has no detailed job story`);
const story = job.story;
const isListen = job.id === 'listen';
const storyId = `job-${job.id}`;
const stageTitleId = `${storyId}-stage-title`;
const mechanismTitleId = `${storyId}-mechanism-title`;
const demonstrationTabId = (stateId: string) => `${storyId}-tab-${stateId}`;
const demonstrationPanelId = (stateId: string) => `${storyId}-panel-${stateId}`;
const taskId = (id: string) => `${storyId}-task-${id}`;
---

{surface === 'home' && (
  <section
    class:list={['product-stage', `${job.id}-product-stage`]}
    aria-labelledby={stageTitleId}
    data-job-story={job.id}
    data-story-surface="home"
    data-job-demo={job.id}
  >
    <div class="stage-bar">
      <span class="stage-brand">Mumble / {job.label}</span>
      <span class="stage-state"><i aria-hidden="true"></i>{isListen ? 'Online speech requirements visible' : 'Local route by default'}</span>
    </div>

    <figure class:list={['write-capture', isListen && 'listen-capture']}>
      <img
        src={isListen ? '/product/reader.webp' : '/product/home.webp'}
        width="1180"
        height="820"
        loading={isListen ? 'lazy' : 'eager'}
        fetchpriority={isListen ? 'auto' : 'high'}
        alt={isListen
          ? 'Genuine Mumble Reader capture showing online voice selection, library tabs, Continue Reading progress, and demonstration library content'
          : 'Genuine Mumble Home capture showing Start dictation, the Dictate shortcut, latest result, and local transcription status'}
      />
      <figcaption>
        <strong>{isListen ? 'Genuine Mumble Reader' : 'Genuine Mumble capture'}</strong>
        <span>{isListen ? 'Current interface with clearly labelled demonstration library content' : 'Current accepted Windows source surface'}</span>
      </figcaption>
    </figure>

    <div class="write-closeup">
      <header class="write-closeup-header">
        <h2 id={stageTitleId}>{isListen ? 'See the complete Listen path.' : 'See where your words return.'}</h2>
        <p>{story.demonstration.note}</p>
        {isListen && (
          <p>Playback uses your configured online text-to-speech route; this website itself does not play audio.</p>
        )}
      </header>

      <div class="write-demo-tabs" role="tablist" aria-label={`${job.label} demonstration steps`} data-job-tablist={job.id}>
        {story.demonstration.states.map((state, index) => (
          <button
            id={demonstrationTabId(state.id)}
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={demonstrationPanelId(state.id)}
            tabindex={index === 0 ? '0' : '-1'}
            data-job-tab={job.id}
          >
            <span aria-hidden="true">{index + 1}</span>
            {state.label}
          </button>
        ))}
      </div>

      <div class="write-demo-panels">
        {story.demonstration.states.map((state) => (
          <section
            id={demonstrationPanelId(state.id)}
            class="write-demo-panel"
            role="tabpanel"
            aria-labelledby={demonstrationTabId(state.id)}
            tabindex="0"
            data-job-panel={job.id}
          >
            <div class="write-panel-copy">
              <span class="write-state-label">{state.status}</span>
              <h3>{state.title}</h3>
              <p>{state.body}</p>
            </div>
            {isListen ? (
              <div class="listen-demo-field" aria-label={`Illustrative Reader close-up during ${state.label}`}>
                <span>Illustrative Reader close-up</span>
                <strong>{state.field}</strong>
                <small>{'detail' in state ? state.detail : ''}</small>
              </div>
            ) : (
              <div class="write-field" aria-label={`Illustrative writing field during ${state.label}`}>
                <span>Unbranded writing field</span>
                <p>{state.field}<i aria-hidden="true"></i></p>
              </div>
            )}
            {state.id === 'speak' && 'spoken' in story.demonstration && (
              <p class="write-spoken-sample">
                <strong>Example speech</strong>
                <q>{story.demonstration.spoken}</q>
              </p>
            )}
          </section>
        ))}
      </div>

      <div class="write-demo-controls" role="group" aria-label={`${job.label} demonstration navigation`}>
        <button class="button button-quiet" type="button" data-job-previous={job.id}>Previous {job.label} step</button>
        <button class="button button-quiet" type="button" data-job-next={job.id}>Next {job.label} step</button>
      </div>
    </div>
  </section>
)}

{surface === 'product' && (
  <section
    class="job-story job-story-mechanism shell"
    aria-labelledby={mechanismTitleId}
    data-job-story={job.id}
    data-story-surface="product"
  >
    <header class="section-intro">
      <h2 id={mechanismTitleId}>{story.mechanism.title}</h2>
      <p>{story.mechanism.summary}</p>
    </header>

    {isListen && (
      <figure class="reader-product-proof">
        <img
          src="/product/reader.webp"
          width="1180"
          height="820"
          loading="lazy"
          alt="Genuine Mumble Reader capture showing the online voice route and a saved library with demonstration document titles"
        />
        <figcaption>
          <strong>Genuine Mumble Reader interface</strong>
          <span>Demonstration library content; the controls and route shown are current product evidence.</span>
        </figcaption>
      </figure>
    )}

    <ol class="job-sequence">
      {story.mechanism.steps.map((step, index) => (
        <li>
          <span class="job-sequence-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <small>{step.proof}</small>
          </div>
        </li>
      ))}
    </ol>

    {isListen && (
      <div class="reader-route-boundaries">
        <aside class="reader-online-boundary" role="note" aria-label="Reader speech online requirements">
          <div>
            <h3>Reader speech uses a configured online text-to-speech route.</h3>
            <p>Short document passages go to the deliberately selected provider to create audio. Mumble does not describe this speech route as local or offline.</p>
          </div>
          <dl>
            <div><dt>Connection</dt><dd>Network access required</dd></div>
            <div><dt>Access</dt><dd>User provider key required</dd></div>
            <div><dt>Service</dt><dd>Provider availability required</dd></div>
            <div><dt>Cost boundary</dt><dd>Available provider credits required</dd></div>
          </dl>
        </aside>
        <aside class="reader-summary-boundary" role="note" aria-label="Reader summary boundary">
          <h3>Summary stays separate from playback.</h3>
          <p>Only when you choose Summary and its configured analysis route is ready does Mumble send document text to that provider. Saved position and playback do not depend on a summary.</p>
        </aside>
      </div>
    )}
  </section>
)}

{surface === 'use-cases' && (
  <section
    class="job-story job-story-tasks shell"
    aria-label={`${job.label} task sequences`}
    data-job-story={job.id}
    data-story-surface="use-cases"
  >
    <div class="task-ledger">
      {story.tasks.map((task) => (
        <article id={taskId(task.id)}>
          <header>
            <h2>{task.title}</h2>
            <p>{task.summary}</p>
          </header>
          <ol>
            {task.steps.map((step, index) => (
              <li>
                <span aria-hidden="true">{index + 1}</span>
                <p>{step}</p>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
    {isListen && (
      <aside class="reader-task-route" role="note" aria-label="Listen task route">
        <strong>Tasks rather than professions.</strong>
        <p>Every Listen sequence keeps the configured online text-to-speech route visible. Network access, a user provider key, provider availability, and provider credits remain required for playback; optional Summary remains separate.</p>
      </aside>
    )}
  </section>
)}
