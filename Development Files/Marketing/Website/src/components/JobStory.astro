---
import jobs from '../data/jobs.json';

type Job = (typeof jobs)[number];
type StorySurface = 'home' | 'product' | 'use-cases';

export interface Props {
  job: Job;
  surface: StorySurface;
}

const { job, surface } = Astro.props;
if (!job.story) throw new Error(`${job.label} has no detailed job story`);
const story = job.story;
const storyId = `job-${job.id}`;
const stageTitleId = `${storyId}-stage-title`;
const mechanismTitleId = `${storyId}-mechanism-title`;
const demonstrationTabId = (stateId: string) => `${storyId}-tab-${stateId}`;
const demonstrationPanelId = (stateId: string) => `${storyId}-panel-${stateId}`;
const taskId = (id: string) => `${storyId}-task-${id}`;
---

{surface === 'home' && job.id === 'write' && (
  <section
    class="product-stage write-product-stage"
    aria-labelledby={stageTitleId}
    data-job-story={job.id}
    data-story-surface="home"
    data-job-demo={job.id}
  >
    <div class="stage-bar">
      <span class="stage-brand">Mumble / {job.label}</span>
      <span class="stage-state"><i aria-hidden="true"></i>Local route by default</span>
    </div>

    <figure class="write-capture">
      <img
        src="/product/home.webp"
        width="1180"
        height="820"
        loading="eager"
        fetchpriority="high"
        alt="Genuine Mumble Home capture showing Start dictation, the Dictate shortcut, latest result, and local transcription status"
      />
      <figcaption>
        <strong>Genuine Mumble capture</strong>
        <span>Current accepted Windows source surface</span>
      </figcaption>
    </figure>

    <div class="write-closeup">
      <header class="write-closeup-header">
        <h2 id={stageTitleId}>See where your words return.</h2>
        <p>{story.demonstration.note}</p>
      </header>

      <div class="write-demo-tabs" role="tablist" aria-label={`${job.label} demonstration steps`} data-job-tablist={job.id}>
        {story.demonstration.states.map((state, index) => (
          <button
            id={demonstrationTabId(state.id)}
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={demonstrationPanelId(state.id)}
            tabindex={index === 0 ? '0' : '-1'}
            data-job-tab={job.id}
          >
            <span aria-hidden="true">{index + 1}</span>
            {state.label}
          </button>
        ))}
      </div>

      <div class="write-demo-panels">
        {story.demonstration.states.map((state) => (
          <section
            id={demonstrationPanelId(state.id)}
            class="write-demo-panel"
            role="tabpanel"
            aria-labelledby={demonstrationTabId(state.id)}
            tabindex="0"
            data-job-panel={job.id}
          >
            <div class="write-panel-copy">
              <span class="write-state-label">{state.status}</span>
              <h3>{state.title}</h3>
              <p>{state.body}</p>
            </div>
            <div class="write-field" aria-label={`Illustrative writing field during ${state.label}`}>
              <span>Unbranded writing field</span>
              <p>{state.field}<i aria-hidden="true"></i></p>
            </div>
            {state.id === 'speak' && (
              <p class="write-spoken-sample">
                <strong>Example speech</strong>
                <q>{story.demonstration.spoken}</q>
              </p>
            )}
          </section>
        ))}
      </div>

      <div class="write-demo-controls" role="group" aria-label={`${job.label} demonstration navigation`}>
        <button class="button button-quiet" type="button" data-job-previous={job.id}>Previous {job.label} step</button>
        <button class="button button-quiet" type="button" data-job-next={job.id}>Next {job.label} step</button>
      </div>
    </div>
  </section>
)}

{surface === 'home' && job.id === 'find' && (
  <section
    class="product-stage find-product-stage shell"
    aria-labelledby={stageTitleId}
    data-job-story={job.id}
    data-story-surface="home"
  >
    <div class="stage-bar">
      <span class="stage-brand">Mumble / {job.label}</span>
      <span class="stage-state"><i aria-hidden="true"></i>Local and online stay separate</span>
    </div>

    <header class="find-stage-heading">
      <div>
        <h2 id={stageTitleId}>{story.opening.title}</h2>
        <p>{story.demonstration.note}</p>
      </div>
      <a class="text-link" href="/product/#find-mechanism">See how Find works</a>
    </header>

    <div class="find-stage-layout">
      <figure class="find-deck-capture">
        <img
          src="/product/deck-command-surface.webp"
          width="1152"
          height="800"
          loading="eager"
          alt="Genuine current Mumble Deck capture showing searchable content types, Starred filtering, Pin or Unpin, and the separate Mumble Find command"
        />
        <figcaption>
          <strong>Genuine Mumble Deck capture</strong>
          <span>Search saved text, filter Starred material, then copy, paste, or shape it again.</span>
        </figcaption>
      </figure>

      <div class="find-route-stack">
        <article class="find-route find-route-local" data-find-route="local">
          <header>
            <span>Private on this device</span>
            <h3>Mumble Find</h3>
            <p>Find apps &amp; files from local indexed results. Hosted web results never enter this list.</p>
          </header>
          <div class="find-query" aria-label="Illustrative Mumble Find query">
            <span>Illustrative query</span>
            <strong>project brief</strong>
          </div>
          <div class="find-result-demo" aria-label="Illustrative local results, not user data">
            <span class="find-demo-label">Interface illustration · illustrative local results</span>
            <div>
              <strong>Project brief.docx</strong>
              <small>Illustrative file · not user data</small>
            </div>
            <p aria-label="Available result actions">Open · Show in folder · Drag to another app</p>
          </div>
        </article>

        <article class="find-route find-route-web" data-find-route="web">
          <header>
            <span>Separate consent-gated action</span>
            <h3>Web Search</h3>
            <p>Selected words stay on this computer until a confirmation names the chosen provider.</p>
          </header>
          <blockquote>
            <span>Illustrative selected text · not user data</span>
            “Compare the quarterly outline with the launch notes.”
          </blockquote>
          <dl>
            <div><dt>Chosen provider</dt><dd>Perplexity</dd></div>
            <div><dt>Before confirmation</dt><dd>Words remain local</dd></div>
            <div><dt>After Search online</dt><dd>Selected words go to Perplexity</dd></div>
          </dl>
          <p class="find-failure-truth">If the browser cannot open, Mumble reports that Web Search could not open. Failure never appears as browser success.</p>
        </article>
      </div>
    </div>
  </section>
)}

{surface === 'product' && (
  <section
    class="job-story job-story-mechanism shell"
    id={job.id === 'find' ? 'find-mechanism' : undefined}
    aria-labelledby={mechanismTitleId}
    data-job-story={job.id}
    data-story-surface="product"
  >
    <header class="section-intro">
      <h2 id={mechanismTitleId}>{story.mechanism.title}</h2>
      <p>{story.mechanism.summary}</p>
    </header>

    {job.id === 'find' && (
      <div class="find-boundary-ledger" aria-label="Deck, local Mumble Find, and Web Search boundaries">
        <article data-find-boundary="deck">
          <div class="find-boundary-name">
            <span>Saved Mumble material</span>
            <h3>Deck history</h3>
          </div>
          <div>
            <p>Search all Deck content across Transcripts, Clipboard, Prompts, and Emails. Use Starred to return to material kept for reuse.</p>
          </div>
          <ul aria-label="Deck reuse actions">
            <li>Read the full saved item</li>
            <li>Copy or Paste latest</li>
            <li>Select material to shape again</li>
          </ul>
        </article>

        <article data-find-boundary="local">
          <div class="find-boundary-name">
            <span>Private on this device</span>
            <h3>Mumble Find</h3>
          </div>
          <div>
            <p>Find apps &amp; files from local apps and indexed files. Hosted web results never appear in this local list.</p>
            <div class="find-product-result" aria-label="Illustrative local Mumble Find result, not user data">
              <span>Interface illustration · illustrative local result</span>
              <strong>Project brief.docx</strong>
              <small>Demonstration file · not user data</small>
            </div>
          </div>
          <ul aria-label="Mumble Find result actions">
            <li>Open</li>
            <li>Show in folder</li>
            <li>Drag to another app</li>
          </ul>
        </article>

        <article data-find-boundary="web">
          <div class="find-boundary-name">
            <span>Separate online route</span>
            <h3>Web Search</h3>
          </div>
          <div>
            <p>Selected words remain on this computer until a provider-named confirmation is accepted with Search online.</p>
            <blockquote>
              <span>Illustrative selected text · not user data</span>
              “Compare the quarterly outline with the launch notes.”
            </blockquote>
          </div>
          <ul aria-label="Web Search provider and outcome truth">
            <li>Provider: Google, Perplexity, or Brave</li>
            <li>Keep private cancels</li>
            <li>Browser could not open is shown as failure</li>
          </ul>
        </article>
      </div>
    )}

    <ol class="job-sequence">
      {story.mechanism.steps.map((step, index) => (
        <li>
          <span class="job-sequence-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <small>{step.proof}</small>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}

{surface === 'use-cases' && (
  <section
    class="job-story job-story-tasks shell"
    aria-label={`${job.label} task sequences`}
    data-job-story={job.id}
    data-story-surface="use-cases"
  >
    <div class="task-ledger">
      {story.tasks.map((task) => (
        <article id={taskId(task.id)}>
          <header>
            <h2>{task.title}</h2>
            <p>{task.summary}</p>
            {job.id === 'find' && task.id === 'local-app-file' && (
              <div class="find-task-example" aria-label="Illustrative local result, not user data">
                <span>Illustrative local result · not user data</span>
                <strong>Project brief.docx</strong>
                <small>Example action: Show in folder</small>
              </div>
            )}
            {job.id === 'find' && task.id === 'web-search' && (
              <blockquote class="find-task-example">
                <span>Illustrative selected text · not user data</span>
                “Compare the quarterly outline with the launch notes.”
                <small>Chosen provider in this demonstration: Perplexity</small>
              </blockquote>
            )}
          </header>
          <ol>
            {task.steps.map((step, index) => (
              <li>
                <span aria-hidden="true">{index + 1}</span>
                <p>{step}</p>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>
)}
