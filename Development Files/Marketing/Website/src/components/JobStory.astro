---
import jobs from '../data/jobs.json';

type Job = (typeof jobs)[number];
type StorySurface = 'home' | 'product' | 'use-cases';

export interface Props {
  job: Job;
  surface: StorySurface;
}

const { job, surface } = Astro.props;
if (!job.story) throw new Error(`${job.label} has no detailed job story`);
const story = job.story;
const findPresentation = 'presentation' in story ? story.presentation : undefined;
const futureMedia = 'futureMedia' in story ? story.futureMedia : undefined;
const storyId = `job-${job.id}`;
const stageTitleId = `${storyId}-stage-title`;
const mechanismTitleId = `${storyId}-mechanism-title`;
const demonstrationTabId = (stateId: string) => `${storyId}-tab-${stateId}`;
const demonstrationPanelId = (stateId: string) => `${storyId}-panel-${stateId}`;
const taskId = (id: string) => `${storyId}-task-${id}`;
const demonstrationPresentation = 'presentation' in story.demonstration
  ? story.demonstration.presentation
  : undefined;
const capturePresentation = demonstrationPresentation?.kind === 'capture' ? demonstrationPresentation : null;
const routePresentation = demonstrationPresentation?.kind === 'route' ? demonstrationPresentation : null;
const routeSteps = routePresentation?.steps ?? [];
const hasEvidenceStates = story.demonstration.states.some((state) => 'image' in state);
if (demonstrationPresentation && !capturePresentation && !routePresentation) {
  throw new Error(`${job.label} story has an unsupported demonstration presentation`);
}
if (routePresentation && routeSteps.length === 0) {
  throw new Error(`${job.label} route presentation has no steps`);
}
---

{surface === 'home' && !findPresentation && (
  <section
    class:list={['product-stage', 'job-product-stage', `${job.id}-product-stage`]}
    aria-labelledby={stageTitleId}
    data-job-story={job.id}
    data-story-surface="home"
    data-job-demo={job.id}
  >
    <div class="stage-bar">
      <span class="stage-brand">Mumble / {job.label}</span>
      <span class="stage-state">
        <i aria-hidden="true"></i>
        {'stageStatus' in story.demonstration
          ? story.demonstration.stageStatus
          : 'Current route visible'}
      </span>
    </div>

    {capturePresentation ? (
      <figure class="write-capture">
        <img
          src={capturePresentation.src}
          width={capturePresentation.width}
          height={capturePresentation.height}
          loading={capturePresentation.priority === 'high' ? 'eager' : 'lazy'}
          fetchpriority={capturePresentation.priority === 'high' ? 'high' : 'auto'}
          alt={capturePresentation.alt}
        />
        <figcaption>
          <strong>{capturePresentation.captionTitle}</strong>
          <span>{capturePresentation.captionDetail}</span>
        </figcaption>
      </figure>
    ) : routePresentation ? (
      <div class="job-route-summary" aria-label={routePresentation.ariaLabel}>
        {routeSteps.map((step, index) => (
          <>
            {index > 0 && <i aria-hidden="true"></i>}
            <div data-mode={'mode' in step ? step.mode : undefined}>
              <span>{step.label}</span>
              <strong>{step.value}</strong>
            </div>
          </>
        ))}
      </div>
    ) : null}

    <div class:list={['write-closeup', hasEvidenceStates && 'capture-closeup']}>
      <header class="write-closeup-header">
        <h2 id={stageTitleId}>{'title' in story.demonstration ? story.demonstration.title : story.opening.title}</h2>
        <p>{story.demonstration.note}</p>
      </header>

      <div class="write-demo-tabs" role="tablist" aria-label={`${job.label} demonstration steps`} data-job-tablist={job.id}>
        {story.demonstration.states.map((state, index) => (
          <button
            id={demonstrationTabId(state.id)}
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={demonstrationPanelId(state.id)}
            tabindex={index === 0 ? '0' : '-1'}
            data-job-tab={job.id}
          >
            <span aria-hidden="true">{index + 1}</span>
            {state.label}
          </button>
        ))}
      </div>

      <div class="write-demo-panels">
        {story.demonstration.states.map((state) => (
          <section
            id={demonstrationPanelId(state.id)}
            class:list={['write-demo-panel', hasEvidenceStates && 'capture-demo-panel']}
            role="tabpanel"
            aria-labelledby={demonstrationTabId(state.id)}
            tabindex="0"
            data-job-panel={job.id}
          >
            <div class="write-panel-copy">
              <span class="write-state-label" data-mode={'mode' in state ? state.mode : undefined}>{state.status}</span>
              <h3>{state.title}</h3>
              <p>{state.body}</p>
            </div>
            {'image' in state ? (
              <figure class="capture-demo-media">
                <img
                  src={state.image}
                  width="1152"
                  height="800"
                  loading="lazy"
                  alt={state.alt}
                />
                <figcaption>
                  <strong>{'mediaCaptionTitle' in story.demonstration ? story.demonstration.mediaCaptionTitle : 'Genuine Mumble capture'}</strong>
                  <span>{'mediaCaptionDetail' in story.demonstration ? story.demonstration.mediaCaptionDetail : 'Current accepted product evidence'}</span>
                </figcaption>
              </figure>
            ) : (
              <div class="write-field" data-mode={'mode' in state ? state.mode : undefined} aria-label={`Illustrative writing field during ${state.label}`}>
                <span>{'fieldLabel' in state ? state.fieldLabel : 'Unbranded writing field'}</span>
                <p>{state.field}<i aria-hidden="true"></i></p>
              </div>
            )}
            {('spoken' in state || (state.id === 'speak' && 'spoken' in story.demonstration)) && (
              <p class="write-spoken-sample">
                <strong>Example speech</strong>
                <q>{'spoken' in state ? state.spoken : 'spoken' in story.demonstration ? story.demonstration.spoken : ''}</q>
              </p>
            )}
          </section>
        ))}
      </div>

      <div class="write-demo-controls" role="group" aria-label={`${job.label} demonstration navigation`}>
        <button class="button button-quiet" type="button" data-job-previous={job.id}>Previous {job.label} step</button>
        <button class="button button-quiet" type="button" data-job-next={job.id}>Next {job.label} step</button>
      </div>
    </div>
  </section>
)}

{surface === 'home' && findPresentation && (
  <section
    class="product-stage find-product-stage shell"
    aria-labelledby={stageTitleId}
    data-job-story={job.id}
    data-story-surface="home"
  >
    <div class="stage-bar">
      <span class="stage-brand">Mumble / {job.label}</span>
      <span class="stage-state"><i aria-hidden="true"></i>{findPresentation.stage.status}</span>
    </div>

    <header class="find-stage-heading">
      <div>
        <h2 id={stageTitleId}>{story.opening.title}</h2>
        <p>{story.demonstration.note}</p>
      </div>
      <a class="text-link" href={findPresentation.stage.actionHref}>{findPresentation.stage.actionLabel}</a>
    </header>

    <div class="find-stage-layout">
      <div class="find-capture-grid" aria-label={findPresentation.capturesAriaLabel}>
        {findPresentation.captures.map((capture) => (
          <figure class:list={['find-capture', `find-capture-${capture.route}`]} data-find-capture={capture.route}>
            <img
              src={capture.src}
              width={capture.width}
              height={capture.height}
              loading={capture.loading as 'eager' | 'lazy'}
              fetchpriority={capture.fetchPriority as 'auto' | 'high' | 'low' | undefined}
              alt={capture.alt}
            />
            <figcaption>
              <strong>{capture.label}</strong>
              <span>{capture.caption}</span>
              <small>{capture.truthLabel}</small>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="find-route-stack">
        {findPresentation.boundaries.filter((boundary) => boundary.showOnHome).map((boundary) => (
          <article class:list={['find-route', `find-route-${boundary.route}`]} data-find-route={boundary.route}>
            <header>
              <span>{boundary.label}</span>
              <h3>{boundary.title}</h3>
              <p>{boundary.body}</p>
            </header>
            {boundary.example?.quote && (
              <blockquote aria-label={boundary.example.ariaLabel}>
                <span>{boundary.example.label}</span>
                <q>{boundary.example.quote}</q>
              </blockquote>
            )}
            {boundary.example?.title && (
              <div class="find-result-demo" aria-label={boundary.example.ariaLabel}>
                <span class="find-demo-label">{boundary.example.label}</span>
                <div>
                  <strong>{boundary.example.title}</strong>
                  <small>{boundary.example.detail}</small>
                </div>
                <p aria-label={boundary.actionsLabel}>{boundary.actions.join(' · ')}</p>
              </div>
            )}
            {boundary.facts && (
              <dl>
                {boundary.facts.map((fact) => <div><dt>{fact.term}</dt><dd>{fact.detail}</dd></div>)}
              </dl>
            )}
            {boundary.failure && <p class="find-failure-truth">{boundary.failure}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{surface === 'product' && (
  <section
    class="job-story job-story-mechanism shell"
    id={findPresentation?.mechanismId}
    aria-labelledby={mechanismTitleId}
    data-job-story={job.id}
    data-story-surface="product"
  >
    <header class="section-intro">
      <h2 id={mechanismTitleId}>{story.mechanism.title}</h2>
      <p>{story.mechanism.summary}</p>
    </header>

    {findPresentation && (
      <div class="find-boundary-ledger" aria-label={findPresentation.boundariesAriaLabel}>
        {findPresentation.boundaries.map((boundary) => (
          <article data-find-boundary={boundary.route}>
            <div class="find-boundary-name">
              <span>{boundary.label}</span>
              <h3>{boundary.title}</h3>
            </div>
            <div>
              <p>{boundary.body}</p>
              {boundary.example?.title && (
                <div class="find-product-result" aria-label={boundary.example.ariaLabel}>
                  <span>{boundary.example.label}</span>
                  <strong>{boundary.example.title}</strong>
                  <small>{boundary.example.detail}</small>
                </div>
              )}
              {boundary.example?.quote && (
                <blockquote aria-label={boundary.example.ariaLabel}>
                  <span>{boundary.example.label}</span>
                  <q>{boundary.example.quote}</q>
                </blockquote>
              )}
            </div>
            <ul aria-label={boundary.actionsLabel}>
              {boundary.actions.map((action) => <li>{action}</li>)}
            </ul>
          </article>
        ))}
      </div>
    )}

    <ol class="job-sequence">
      {story.mechanism.steps.map((step, index) => (
        <li>
          <span class="job-sequence-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <small>{step.proof}</small>
          </div>
        </li>
      ))}
    </ol>

    {futureMedia && (
      <>
        <div class="capture-proof-grid" aria-label="Accepted Capture interface evidence">
          {story.demonstration.states.map((state) => 'image' in state && (
            <figure>
              <img src={state.image} width="1152" height="800" loading="lazy" alt={state.alt} />
              <figcaption>
                <strong>{state.status}</strong>
                <span>Genuine Mumble interface with demonstration meeting data</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <aside class="future-media-gate" role="note" aria-label={futureMedia.ariaLabel}>
          <div>
            <h3>{futureMedia.title}</h3>
            <p>{futureMedia.body}</p>
          </div>
          <dl>
            {futureMedia.items.map((item) => <div><dt>{item.term}</dt><dd>{item.detail}</dd></div>)}
          </dl>
        </aside>
      </>
    )}
  </section>
)}

{surface === 'use-cases' && (
  <section
    class="job-story job-story-tasks shell"
    aria-label={`${job.label} task sequences`}
    data-job-story={job.id}
    data-story-surface="use-cases"
  >
    <div class="task-ledger">
      {story.tasks.map((task) => (
        <article id={taskId(task.id)}>
          <header>
            <h2>{task.title}</h2>
            <p>{task.summary}</p>
            {'example' in task && task.example?.title && (
              <div class="find-task-example" aria-label={task.example.ariaLabel}>
                <span>{task.example.label}</span>
                <strong>{task.example.title}</strong>
                <small>{task.example.detail}</small>
              </div>
            )}
            {'example' in task && task.example?.quote && (
              <blockquote class="find-task-example" aria-label={task.example.ariaLabel}>
                <span>{task.example.label}</span>
                <q>{task.example.quote}</q>
                <small>{task.example.detail}</small>
              </blockquote>
            )}
          </header>
          <ol>
            {task.steps.map((step, index) => (
              <li>
                <span aria-hidden="true">{index + 1}</span>
                <p>{step}</p>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>
)}
