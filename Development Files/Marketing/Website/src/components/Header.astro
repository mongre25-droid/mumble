---
import Logo from './Logo.astro';
import PlatformAction from './PlatformAction.astro';

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const navigation = [
  { label: 'Home', href: '/', current: currentPath === '/' },
  { label: 'Five jobs', href: '/#jobs', current: false },
  { label: 'Privacy', href: '/privacy/', current: currentPath === '/privacy/' },
  { label: 'Downloads', href: '/downloads/', current: currentPath === '/downloads/' },
  { label: 'Help', href: '/help/', current: currentPath === '/help/' },
];
---

<header class="site-header" data-site-header>
  <div class="shell header-shell">
    <a class="brand-link" href="/" aria-label="Mumble home" data-menu-background>
      <Logo />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
      data-menu-toggle
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <div class="site-menu" id="site-menu" data-site-menu>
      <nav aria-label="Primary">
        {navigation.map((item) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <PlatformAction className="header-action" />
    </div>
  </div>
</header>
