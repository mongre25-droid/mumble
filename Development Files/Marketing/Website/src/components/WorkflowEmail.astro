---
// WorkflowEmail.astro — Email workflow section.
// Reply-from-highlight demo with before/after visual.
// Outcome-focused headlines. No voice formatting commands are implied.
// Email mode activation: toggle Email or Reply on the Island Mode Deck before dictating.
---

<section class="section" id="email">
  <div class="container">

    <!-- ===== Section Head ===== -->
    <div class="section-head center">
      <span class="h-kicker center">Email &amp; Reply</span>
      <h2 class="section-title reveal">Draft replies from anything you highlight.</h2>
      <p class="section-lead reveal d1">
        Mumble&rsquo;s Reply mode reads what you&rsquo;ve highlighted &mdash; or your latest
        clipboard item &mdash; and drafts a reply in your voice that matches the tone.
        Paired with Email mode, you can compose from scratch or respond in seconds.
      </p>
    </div>

    <!-- ===== Activation: How it works ===== -->
    <div class="email-activation reveal d2" style="margin-top:40px; text-align:center;">
      <p class="t-mute" style="font-size:.92rem; margin-bottom:16px; letter-spacing:.03em; text-transform:uppercase;">
        How you switch into Reply mode
      </p>
      <div style="display:inline-flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center;">
        <span style="color:var(--text-dim);font-weight:500;">Toggle</span>
        <span class="chip" style="color:var(--mode-reply);border-color:rgba(232,130,90,.35);background:rgba(232,130,90,.08);">
          &ldquo;reply&rdquo;
        </span>
        <span style="color:var(--text-dim);font-weight:500;">on the Island Mode Deck</span>
      </div>
      <p class="t-mute" style="font-size:.84rem; margin-top:12px;">
        Tap a mode on the Island Deck to arm it, then dictate your reply.
      </p>
    </div>

    <!-- ===== Before/After Visual Demo ===== -->
    <div class="email-demo reveal d3" style="margin-top:48px;">
      <div class="email-demo-grid">

        <!-- Before: Highlighted text -->
        <div class="card pad lift sheen email-before-card" style="--edge:var(--mode-reply)">
          <div class="email-card-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/>
            </svg>
            <span>Highlighted text</span>
          </div>
          <div class="email-highlight-box">
            <p>
              <span class="email-highlight-text">
                Hey, can you send me the latest designs by Thursday? Also, can we move the standup to 10 AM instead of 9? Thanks!
              </span>
            </p>
            <div class="email-highlight-meta">
              <span class="t-mute" style="font-size:.78rem;">Selected in any app &mdash; browser, email client, chat, editor</span>
            </div>
          </div>
        </div>

        <!-- Arrow between -->
        <div class="email-arrow" aria-hidden="true">
          <div class="email-arrow-step">
            <span class="chip" style="color:var(--mode-reply);border-color:rgba(232,130,90,.35);background:rgba(232,130,90,.08);">reply</span> toggled on Island Deck
          </div>
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
          <div class="email-arrow-step" style="font-size:.82rem;color:var(--text-mute);">
            Dictate your response
          </div>
        </div>

        <!-- After: Generated reply -->
        <div class="card pad lift sheen email-after-card" style="--edge:var(--green)">
          <div class="email-card-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Mumble&rsquo;s reply</span>
          </div>
          <div class="email-reply-box">
            <p class="email-reply-greeting">Hi,</p>
            <p class="email-reply-body">
              Sure &mdash; I&rsquo;ll have the latest designs over to you by Thursday.
              And moving the standup to 10 AM works perfectly for me.
            </p>
            <p class="email-reply-body" style="margin-top:6px;">
              Let me know if you need anything else in the meantime.
            </p>
            <p class="email-reply-signoff" style="margin-top:12px;">Best,</p>
            <p class="email-reply-signoff">Alex</p>
            <div class="email-reply-meta" style="margin-top:10px;">
              <span class="chip-sm" style="color:var(--mode-reply);border-color:rgba(232,130,90,.3);background:rgba(232,130,90,.06);">Reply mode</span>
              <span class="t-mute" style="font-size:.76rem;">Tone-matched &middot; pasted at your cursor</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ===== Email Mode Demo: Compose from scratch ===== -->
    <div class="email-compose reveal d4" style="margin-top:48px;">
      <div class="card pad" style="text-align:center;max-width:720px;margin-inline:auto;">

        <div class="flow-head" style="justify-content:center;">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--mode-email)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <h3>Compose fresh emails, too</h3>
        </div>

        <p style="color:var(--text-dim);font-size:.94rem;line-height:1.6;margin-bottom:20px;">
          Toggle
          <span style="color:var(--mode-email);font-weight:600;">&ldquo;email&rdquo;</span>
          on the Island Mode Deck &mdash;
          then dictate your message. Mumble structures it into a tidy email with a greeting,
          body, and sign-off, ready to paste wherever your cursor is.
        </p>

        <!-- Email before/after mini -->
        <div class="email-mini-demo" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;text-align:left;">
          <!-- What you say -->
          <div style="background:var(--surface-2);border:1px solid var(--border-soft);border-radius:var(--r-md);padding:16px;">
            <div class="t-mute" style="font-size:.72rem;letter-spacing:.05em;text-transform:uppercase;margin-bottom:8px;">What you say</div>
            <p style="font-size:.86rem;color:var(--text-dim);line-height:1.6;font-style:italic;">
              &ldquo;Let Sarah know the latest revision looks great and we&rsquo;ll ship Friday.&rdquo;
            </p>
          </div>

          <!-- What you get -->
          <div class="email-mini-result" style="background:var(--surface-2);border:1px solid var(--border-soft);border-radius:var(--r-md);padding:16px;position:relative;">
            <div class="t-mute" style="font-size:.72rem;letter-spacing:.05em;text-transform:uppercase;margin-bottom:8px;">What Mumble produces</div>
            <p style="font-size:.86rem;color:var(--text-dim);line-height:1.6;margin:0;">
              <span style="color:var(--text);">Hi Sarah,</span><br>
              <span style="color:var(--text-dim);">The latest revision looks great &mdash; thank you. We&rsquo;re on track to ship Friday as planned.</span><br><br>
              <span style="color:var(--text);">Best,</span><br>
              <span style="color:var(--text-dim);">Alex</span>
            </p>
            <span class="chip-sm" style="position:absolute;top:12px;right:12px;color:var(--mode-email);border-color:rgba(90,169,230,.3);background:rgba(90,169,230,.06);">Email mode</span>
          </div>
        </div>

        <p style="color:var(--text-mute);font-size:.84rem;margin-top:16px;">
          All formatting &mdash; paragraphs, structure, and tone &mdash; is handled by the AI polish.
          Formatting is the AI&rsquo;s job, not voice commands.
        </p>
      </div>
    </div>

    <!-- ===== Workflow Steps ===== -->
    <div class="email-steps reveal d5" style="margin-top:44px;">
      <div class="flow-steps email-steps-grid">
        <div class="fstep">
          <svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/>
          </svg>
          <div class="fnum">1</div>
          <h4>Highlight</h4>
          <p>Select the text you&rsquo;re replying to &mdash; in any app, anywhere.</p>
        </div>

        <div class="fstep">
          <svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/>
            <path d="M19 10v2a7 7 0 01-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/>
          </svg>
          <div class="fnum">2</div>
          <h4>Toggle &ldquo;reply&rdquo;</h4>
          <p>Tap Reply mode on the Island Deck to arm it.</p>
        </div>

        <div class="fstep">
          <svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
          </svg>
          <div class="fnum">3</div>
          <h4>Dictate your reply</h4>
          <p>Speak naturally. Mumble matches the tone of the original message.</p>
        </div>

        <div class="fstep">
          <svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
          <div class="fnum">4</div>
          <h4>Paste &amp; send</h4>
          <p>Tap the hotkey &mdash; your reply is pasted where your cursor is. Review and send.</p>
        </div>
      </div>
    </div>

    <!-- ===== Both Modes Summary ===== -->
    <div class="email-modes reveal d6" style="margin-top:44px;">
      <div class="email-modes-grid">
        <div class="card pad lift sheen" style="--fc:var(--mode-reply);text-align:center;">
          <div class="feature-ic" style="--fc:var(--mode-reply);margin-inline:auto;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 10 4 15 9 20"/><path d="M20 4v7a4 4 0 01-4 4H4"/>
            </svg>
          </div>
          <h3>Reply mode</h3>
          <p style="color:var(--text-dim);font-size:.92rem;line-height:1.6;">
            <strong>Replies to text you&rsquo;ve highlighted</strong> (or your latest clipboard item).
            Matches tone automatically. Perfect for emails, chats, and comment threads.
          </p>
          <div style="margin-top:14px;">
            <span class="chip-sm" style="color:var(--mode-reply);border-color:rgba(232,130,90,.3);background:rgba(232,130,90,.06);">reply</span>
          </div>
        </div>

        <div class="card pad lift sheen" style="--fc:var(--mode-email);text-align:center;">
          <div class="feature-ic" style="--fc:var(--mode-email);margin-inline:auto;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <h3>Email mode</h3>
          <p style="color:var(--text-dim);font-size:.92rem;line-height:1.6;">
            <strong>Compose from scratch.</strong> Dictate your message and Mumble structures it into a
            complete email with greeting, body, and sign-off. No templates needed.
          </p>
          <div style="margin-top:14px;">
            <span class="chip-sm" style="color:var(--mode-email);border-color:rgba(90,169,230,.3);background:rgba(90,169,230,.06);">email</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== CTA ===== -->
    <div class="email-cta reveal d7" style="margin-top:48px; text-align:center;">
      <a class="btn btn-gold btn-lg" href="#download">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
        </svg>
        Download Mumble &mdash; Free
      </a>
    </div>

  </div>
</section>

<style>
  /* ===== Email Demo Grid ===== */
  .email-demo-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: center;
  }

  .email-before-card { --edge: var(--mode-reply); }
  .email-after-card  { --edge: var(--green); }

  .email-card-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 16px;
  }
  .email-card-label svg {
    width: 16px;
    height: 16px;
    color: var(--edge, var(--gold));
  }

  /* Highlight box (before) */
  .email-highlight-box {
    background: var(--surface-2);
    border: 1px solid rgba(232,130,90,.25);
    border-radius: var(--r-md);
    padding: 18px;
  }
  .email-highlight-text {
    font-size: .92rem;
    color: var(--text);
    line-height: 1.6;
    background: rgba(232,130,90,.12);
    padding: 2px 0;
    border-radius: 3px;
  }
  .email-highlight-meta {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--border-soft);
  }

  /* Reply box (after) */
  .email-reply-box {
    background: var(--surface-2);
    border: 1px solid rgba(90,184,90,.22);
    border-radius: var(--r-md);
    padding: 18px;
  }
  .email-reply-greeting {
    font-size: .92rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 6px;
  }
  .email-reply-body {
    font-size: .88rem;
    color: var(--text-dim);
    line-height: 1.55;
  }
  .email-reply-signoff {
    font-size: .88rem;
    font-weight: 600;
    color: var(--text);
  }
  .email-reply-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--border-soft);
  }

  /* Arrow column */
  .email-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
  }
  .email-arrow-step {
    font-size: .78rem;
    color: var(--text-dim);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .email-arrow svg {
    width: 28px;
    height: 28px;
  }

  /* Email mini demo */
  .email-mini-result {
    position: relative;
  }

  /* Both modes grid */
  .email-modes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  /* Steps grid */
  .email-steps-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  /* ===== Responsive ===== */
  @media (max-width: 1040px) {
    .email-demo-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .email-arrow {
      flex-direction: row;
      justify-content: center;
      gap: 14px;
    }
    .email-arrow svg {
      transform: rotate(90deg);
    }
    .email-steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .email-mini-demo {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .email-modes-grid {
      grid-template-columns: 1fr;
    }
    .email-steps-grid {
      grid-template-columns: 1fr 1fr;
    }
    .email-arrow {
      flex-wrap: wrap;
    }
    .email-arrow-step {
      font-size: .74rem;
    }
  }
  @media (max-width: 480px) {
    .email-steps-grid {
      grid-template-columns: 1fr;
    }
    .email-mini-demo {
      grid-template-columns: 1fr;
    }
  }
</style>
