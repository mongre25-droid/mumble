---
import { statSync } from 'node:fs';
import { resolve } from 'node:path';
import { release } from '../data/release';

const archiveSizeKb = Math.round(
  statSync(resolve(process.cwd(), 'public', 'Mumble.zip')).size / 1000,
).toLocaleString('en-GB');
---

<section class="section download-section" id="download">
  <div class="container">
    <div class="download-panel reveal">
      <div class="download-copy">
        <p class="eyebrow"><span></span>Available now for Windows</p>
        <h2>Ready when you are.</h2>
        <p>
          Download the ZIP, extract it, and run Mumble. The first launch needs an
          internet connection to install Python and the local speech model, then opens the welcome tour.
        </p>
        <a class="button button-gold button-large" href={release.downloadPath} download>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" /></svg>
          Download Mumble · Free
        </a>
        <div class="download-trust">
          <span><i></i>No account required</span>
          <span><i></i>No telemetry</span>
          <span><i></i>Local mode needs no API key</span>
        </div>
        <p class="os-notice" data-os-notice>
          Mumble currently supports Windows. macOS and Linux versions are in development.
        </p>
      </div>

      <div class="release-card">
        <div class="release-card-head">
          <div><span>Current release</span><strong>v{release.version}</strong></div>
          <em>Available</em>
        </div>
        <h3>{release.codename}</h3>
        <dl>
          <div><dt>Package</dt><dd>{archiveSizeKb} KB · ZIP</dd></div>
          <div><dt>Operating system</dt><dd>{release.os}</dd></div>
          <div><dt>Memory</dt><dd>{release.ram}</dd></div>
          <div><dt>Installed size</dt><dd>{release.disk}</dd></div>
          <div><dt>Runtime</dt><dd>{release.runtime}</dd></div>
          <div><dt>Licence</dt><dd>MIT</dd></div>
        </dl>
        <div class="platform-status">
          <span><i class="ready"></i>Windows <b>Available</b></span>
          <span><i></i>macOS <b>In development</b></span>
          <span><i></i>Linux <b>In development</b></span>
        </div>
      </div>
    </div>

    <div class="faq" id="faq">
      <header class="faq-heading reveal">
        <p class="eyebrow"><span></span>Good to know</p>
        <h2>Questions, answered plainly.</h2>
      </header>
      <div class="faq-list reveal delay-1">
        <details>
          <summary>Does my audio leave my computer?<span></span></summary>
          <p>Not in the default Local Transcription mode. If you deliberately select Cloud Transcription, audio is sent to the provider you configure. Pro Mode sends finished text—not audio—to your chosen AI provider.</p>
        </details>
        <details>
          <summary>Can Mumble work offline?<span></span></summary>
          <p>Local dictation and Local meeting transcription work offline after the one-time setup. Reader uses OpenRouter TTS, and selected Pro Mode or Cloud Transcription features also require a network connection.</p>
        </details>
        <details>
          <summary>What does “free” include?<span></span></summary>
          <p>Mumble and Local Transcription are free; you can use them without an account or API key. Optional external AI or cloud-transcription providers may charge for their own usage.</p>
        </details>
        <details>
          <summary>What about macOS and Linux?<span></span></summary>
          <p>Mumble is currently available for 64-bit Windows 10 and later. macOS and Linux versions are actively in development, so the site does not offer placeholder downloads for them yet.</p>
        </details>
      </div>
    </div>
  </div>
</section>
