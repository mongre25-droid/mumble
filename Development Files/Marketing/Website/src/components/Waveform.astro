---
// Waveform.astro — Animated gold waveform bars container.
// Bars are built by client-side JS (buildWave) to match the original
// edge-tapered amplitude distribution and randomized heights.

export interface Props {
  id?: string;
  barCount?: number;
  maxHeight?: number;
  class?: string;
}

const {
  id = "heroWave",
  barCount = 26,
  maxHeight = 56,
  class: extraClass = "",
} = Astro.props;
---

<div class="wave-wrap">
  <div
    class:list={["waveform", "recording", extraClass]}
    id={id}
    data-bar-count={barCount}
    data-max-height={maxHeight}
  ></div>
</div>
