---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformAction from '../components/PlatformAction.astro';
import release from '../data/release.json';

const windows = release.platforms.find((platform) => platform.id === 'windows');
const gatedPlatforms = release.platforms.filter((platform) => platform.availability === 'gated');
if (!windows || !windows.integrity || !windows.artifactLocation) {
  throw new Error('Windows artifact facts are incomplete');
}
const size = `${new Intl.NumberFormat('en-GB', {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
}).format(windows.sizeBytes / 1_000_000)} MB (${new Intl.NumberFormat('en-GB').format(windows.sizeBytes)} bytes)`;
---

<BaseLayout
  title={`Downloads — Mumble ${release.version} ${release.channel.label}`}
  description="Inspect Mumble's current Windows candidate, integrity facts, requirements, publication gate, and truthful macOS and Linux states."
  currentPath="/downloads/"
>
  <section class="downloads-hero shell" aria-labelledby="downloads-title">
    <div>
      <h1 id="downloads-title">Download facts before the download.</h1>
      <p>
        Mumble {release.version} is a {release.channel.label.toLowerCase()} with one accepted Windows artifact in the repository. It is available to inspect and download here without implying installation, signing, deployment, or public-release acceptance.
      </p>
    </div>

    <aside class="recommendation" aria-labelledby="recommendation-title">
      <h2 id="recommendation-title">Choose a desktop package.</h2>
      <p>Detected-platform recommendation changes this action only. Every platform state remains visible below.</p>
      <PlatformAction className="button button-primary" />
    </aside>
  </section>

  <section class="publication-band" aria-labelledby="publication-title">
    <div class="shell publication-grid">
      <div>
        <h2 id="publication-title">{release.publication.label}</h2>
      </div>
      <p>{release.publication.reason}</p>
      <dl>
        <div><dt>Channel</dt><dd>{release.channel.label}</dd></div>
        <div><dt>Publication date</dt><dd>{release.publication.dateLabel}</dd></div>
        <div><dt>Release notes</dt><dd>{release.releaseNotes.label}</dd></div>
      </dl>
    </div>
  </section>

  <section class="platform-section shell" aria-labelledby="platforms-title">
    <header class="section-intro downloads-intro">
      <h2 id="platforms-title">Complete desktop status</h2>
      <p>Unavailable platforms stay visible and never become dead download controls.</p>
    </header>

    <div class="platform-list">
      <article class="platform-primary" id="windows" aria-labelledby="windows-title">
        <header class="platform-heading">
          <div>
            <span>{windows.availabilityLabel}</span>
            <h2 id="windows-title">{windows.label}</h2>
          </div>
          <strong>{release.publication.label}</strong>
        </header>

        <p class="platform-gate">{windows.gate}</p>

        <div class="artifact-grid">
          <dl class="artifact-facts">
            <div><dt>Version</dt><dd>{release.version}</dd></div>
            <div><dt>Channel</dt><dd>{release.channel.label}</dd></div>
            <div><dt>Platform</dt><dd>{windows.label}</dd></div>
            <div><dt>Architecture</dt><dd>{windows.architecture}</dd></div>
            <div><dt>Format</dt><dd>{windows.format}</dd></div>
            <div><dt>Size</dt><dd>{size}</dd></div>
            <div><dt>Artifact location</dt><dd><code>{windows.artifactLocation}</code></dd></div>
            <div><dt>Availability</dt><dd>{windows.availabilityLabel}</dd></div>
          </dl>

          <div class="artifact-detail">
            <div>
              <h3>Requirements</h3>
              <ul>
                {windows.requirements.map((requirement) => <li>{requirement}</li>)}
              </ul>
            </div>
            <div>
              <h3>Integrity</h3>
              <dl>
                <div><dt>Algorithm</dt><dd>{windows.integrity.algorithm}</dd></div>
                <div><dt>SHA-256</dt><dd><code>{windows.integrity.value}</code></dd></div>
                <div><dt>Publisher signature</dt><dd>{windows.integrity.publisherSignature.label}</dd></div>
              </dl>
            </div>
          </div>
        </div>

        <div class="artifact-actions">
          <a class="button button-primary" href={windows.artifactLocation} download>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" /></svg>
            {release.recommendations.windows.label}
          </a>
          <p>Verify the SHA-256 value after download. This candidate is not a public-release claim.</p>
        </div>
      </article>

      <div class="gated-platforms">
        {gatedPlatforms.map((platform) => (
          <article id={platform.id} aria-labelledby={`${platform.id}-title`}>
            <header class="platform-heading">
              <div>
                <span>{platform.availabilityLabel}</span>
                <h2 id={`${platform.id}-title`}>{platform.label}</h2>
              </div>
              <strong>{platform.statusLabel}</strong>
            </header>
            <p>{platform.gate}</p>
            <dl>
              <div><dt>Architecture</dt><dd>{release.unavailableFacts.artifactMetadata}</dd></div>
              <div><dt>Format</dt><dd>{release.unavailableFacts.artifactMetadata}</dd></div>
              <div><dt>Integrity</dt><dd>{release.unavailableFacts.integrity}</dd></div>
              <div><dt>Download</dt><dd>{release.unavailableFacts.download}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="release-notes shell" aria-labelledby="release-notes-title">
    <div>
      <h2 id="release-notes-title">Release notes</h2>
      <strong>{release.releaseNotes.label}</strong>
    </div>
    <p>{release.releaseNotes.summary}</p>
    <a class="text-link" href="/">Return to the Mumble overview</a>
  </section>
</BaseLayout>
