---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobStory from '../components/JobStory.astro';
import PlatformAction from '../components/PlatformAction.astro';
import jobs from '../data/jobs.json';
import release from '../data/release.json';

const write = jobs.find((job) => job.id === 'write');
const find = jobs.find((job) => job.id === 'find');
const capture = jobs.find((job) => job.id === 'capture');
const shape = jobs.find((job) => job.id === 'shape');
const listen = jobs.find((job) => job.id === 'listen');
if (!write?.story) throw new Error('Write story authority is missing');
if (!capture?.story) throw new Error('Capture story authority is missing');
if (!shape?.story) throw new Error('Shape story authority is missing');
if (!listen?.story) throw new Error('Listen story authority is missing');
if (!find?.story) throw new Error('Find story authority is missing');
---

<BaseLayout
  title="Use Cases — Complete Mumble job sequences"
  description="Follow complete Mumble Write, Capture, Shape, Listen, and Find sequences without profession-first navigation."
  currentPath="/use-cases/"
>
  <section class="page-hero use-cases-hero shell" aria-labelledby="use-cases-title">
    <div>
      <h1 id="use-cases-title">Start with the task, not a persona.</h1>
      <p>Write, Capture, Shape, Listen, and Find stay organised by tasks rather than professions. Local dictation needs no Mumble account, provider key, or paid service; hosted shaping and Reader speech retain their separate online boundaries.</p>
    </div>
    <nav class="task-jump" aria-label="Write, Shape, and Find task sequences">
      <span>Write tasks</span>
      {write.story.tasks.map((task) => <a href={`#job-${write.id}-task-${task.id}`}>{task.title}</a>)}
      <span>Shape tasks</span>
      {shape.story.tasks.map((task) => <a href={`#job-${shape.id}-task-${task.id}`}>{task.title}</a>)}
      <span>Find tasks</span>
      {find.story.tasks.map((task) => <a href={`#job-${find.id}-task-${task.id}`}>{task.title}</a>)}
    </nav>
  </section>

  <JobStory job={write} surface="use-cases" />
  <JobStory job={shape} surface="use-cases" />

  <section class="capture-task-intro shell" aria-labelledby="capture-tasks-title">
    <div>
      <h2 id="capture-tasks-title">Capture starts with the recording task.</h2>
      <p>Meetings, lectures, and existing recordings use the same saved-first, route-visible, searchable-record model.</p>
    </div>
    <nav class="task-jump" aria-label="Capture task sequences">
      {capture.story.tasks.map((task) => <a href={`#job-${capture.id}-task-${task.id}`}>{task.title}</a>)}
    </nav>
  </section>

  <JobStory job={capture} surface="use-cases" />

  <section class="listen-task-intro shell" aria-labelledby="listen-tasks-title">
    <div>
      <h2 id="listen-tasks-title">Listen begins with the document you need.</h2>
      <p>Long documents, resumed reading, passage finding, and retained progress follow one library-first path with an explicit online speech boundary.</p>
    </div>
    <nav class="task-jump" aria-label="Listen task sequences">
      {listen.story.tasks.map((task) => <a href={`#job-${listen.id}-task-${task.id}`}>{task.title}</a>)}
    </nav>
  </section>

  <JobStory job={listen} surface="use-cases" />
  <JobStory job={find} surface="use-cases" />

  <section class="journey-next" aria-labelledby="use-cases-next-title">
    <div class="shell journey-next-layout">
      <div>
        <h2 id="use-cases-next-title">See the mechanism, then inspect the candidate.</h2>
        <p>{release.publication.label}. The current package wording and every unavailable platform state remain controlled by the shared release authority.</p>
      </div>
      <div class="journey-next-actions">
        <a class="button button-quiet" href="/product/">How the Mumble jobs work</a>
        <PlatformAction className="button button-primary" />
        <a class="text-link" href="/downloads/">Release details and all platforms</a>
      </div>
    </div>
  </section>
</BaseLayout>
