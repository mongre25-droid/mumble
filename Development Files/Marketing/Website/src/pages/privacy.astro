---
import BaseLayout from '../layouts/BaseLayout.astro';
import { privacyFactDefinitions, privacyRoutes } from '../data/privacy-routes';
---

<BaseLayout
  title="Privacy — Local and Optional Online Routes"
  description="Inspect six distinct Mumble privacy routes: local and cloud transcription, text shaping, Reader speech, Mumble Find, and consent-gated Web Search."
  currentPath="/privacy/"
>
  <section class="privacy-hero shell" aria-labelledby="privacy-page-title">
    <div class="privacy-hero-copy">
      <h1 id="privacy-page-title">Choose when anything leaves your computer.</h1>
      <p>
        Six inspectable routes separate local work from optional online processing. Local Transcription and Mumble Find stay on this computer. Cloud Transcription, Text Shaping, Reader speech, and Web Search each have their own input, provider boundary, requirements, controls, and failure state.
      </p>
      <p>
        Local speech-to-text is the default. Mumble never supplies a provider key, absorbs an external provider's charges, or silently changes a local route into an online one. A saved online choice becomes effective only when its own requirements and controls permit it.
      </p>
    </div>

    <nav class="privacy-route-tabs" aria-label="Explore privacy routes" data-route-tabs>
      {privacyRoutes.map((route) => (
        <a
          id={route.tabId}
          class="privacy-route-tab"
          href={`#${route.panelId}`}
          data-route-tab={route.panelId}
        >
          <span>{route.label}</span>
          <small>{route.tabSummary}</small>
        </a>
      ))}
    </nav>
  </section>

  <section class="privacy-explorer shell" aria-label="Privacy route details">
    {privacyRoutes.map((route) => (
      <article
        class="privacy-route-panel"
        id={route.panelId}
        data-route-panel={route.panelId}
        aria-labelledby={route.titleId}
      >
        <header class="privacy-route-heading">
          <div>
            <h2 id={route.titleId}>{route.label}</h2>
            <p>{route.summary}</p>
          </div>
          <strong>{route.status}</strong>
        </header>

        <div class="route-path" role="group" aria-labelledby={route.pathLabelId}>
          <span id={route.pathLabelId} class="route-path-label">{route.pathLabel}</span>
          <ol class="route-path-visual">
            {route.pathSteps.map((step) => (
              <li><strong>{step.title}</strong><span>{step.detail}</span></li>
            ))}
          </ol>
        </div>

        <div class:list={[
          'route-evidence-layout',
          { 'route-evidence-layout-find': route.evidenceLayout === 'find' },
        ]}>
          <div class="route-explanation">
            <h3>{route.explanation.title}</h3>
            {route.explanation.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          {route.evidence.kind === 'product-proof' ? (
            <figure class="privacy-product-proof">
              <img
                src={route.evidence.image.src}
                width={route.evidence.image.width}
                height={route.evidence.image.height}
                loading="lazy"
                alt={route.evidence.image.alt}
              />
              <figcaption>
                <strong>{route.evidence.captionTitle}</strong>
                <span>{route.evidence.caption}</span>
              </figcaption>
            </figure>
          ) : (
            <section class="source-control-proof" aria-labelledby={route.evidence.titleId}>
              <header>
                <h3 id={route.evidence.titleId}>{route.evidence.title}</h3>
                <p>{route.evidence.description}</p>
              </header>
              <dl>
                {route.evidence.items.map((item) => (
                  <div><dt>{item.term}</dt><dd>{item.detail}</dd></div>
                ))}
              </dl>
            </section>
          )}
        </div>

        <div class="route-table-wrap">
          <table class="route-table">
            <caption>{route.tableCaption}</caption>
            <thead>
              <tr><th scope="col">Route fact</th><th scope="col">Current behaviour</th></tr>
            </thead>
            <tbody>
              {privacyFactDefinitions.map((fact) => (
                <tr><th scope="row">{fact.label}</th><td>{route.facts[fact.key]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>
    ))}
  </section>

  <section class="website-privacy shell" aria-labelledby="website-privacy-title">
    <div>
      <h2 id="website-privacy-title">The website makes a smaller, verifiable promise.</h2>
      <p>This static website says only what its own source and requests can prove. It does not turn that posture into a broader product claim.</p>
    </div>
    <dl>
      <div><dt>Zero-CDN</dt><dd>Fonts, scripts, styles, and product images are served as local site assets.</dd></div>
      <div><dt>No analytics</dt><dd>No analytics runtime is included.</dd></div>
      <div><dt>No tracking</dt><dd>No tracker or advertising pixel is included.</dd></div>
    </dl>
    <div class="privacy-next-actions">
      <a class="button button-primary" href="/downloads/">Inspect current download facts</a>
      <a class="text-link" href="/#jobs">Return to the five jobs</a>
    </div>
  </section>
</BaseLayout>
