---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobStory from '../components/JobStory.astro';
import PlatformAction from '../components/PlatformAction.astro';
import jobs from '../data/jobs.json';
import release from '../data/release.json';

const write = jobs.find((job) => job.id === 'write');
const shape = jobs.find((job) => job.id === 'shape');
const recovery = write?.story?.mechanism.steps.find((step) => step.id === 'recovery');
if (!write?.story) throw new Error('Write story authority is missing');
if (!shape?.story) throw new Error('Shape story authority is missing');
if (!recovery) throw new Error('Write recovery authority is missing');
const shapeModes = shape.story.modes;
if (!shapeModes) throw new Error('Shape mode authority is missing');
---

<BaseLayout
  title="Product — How Mumble Write and Shape work"
  description="Follow Mumble from local dictation and intended-cursor return into optional Prompt, Email, Reply, Foreign, preset, and custom text shaping."
  currentPath="/product/"
>
  <section class="page-hero shell" aria-labelledby="product-title">
    <div>
      <h1 id="product-title">Write lands the text. Shape gives it a job.</h1>
      <p>{write.summary} {shape.summary}</p>
    </div>
    <div class="page-hero-support">
      <p>{shape.proof} Local dictation stays useful with no Mumble account, provider key, or paid service.</p>
      <a class="text-link" href="/use-cases/">See complete Write and Shape tasks</a>
    </div>
  </section>

  <JobStory job={write} surface="product" />

  <section class="product-recovery shell" aria-labelledby="recovery-title">
    <figure class="recovery-capture">
      <img
        src="/product/deck-command-surface.webp"
        width="1152"
        height="800"
        loading="lazy"
        alt="Genuine current Mumble Deck capture showing content type tabs for All, Transcripts, Clipboard, Prompts, and Emails, plus Starred, Pin or Unpin, and More command controls"
      />
      <figcaption>
        <strong>Genuine Mumble capture</strong>
        <span>Current accepted Deck command surface; finished results remain available for recovery.</span>
      </figcaption>
    </figure>
    <div>
      <h2 id="recovery-title">A blocked insertion does not erase the result.</h2>
      <p>{recovery.body}</p>
      <a class="button button-quiet" href="/use-cases/">Follow Write and Shape tasks</a>
    </div>
  </section>

  <JobStory job={shape} surface="product" />

  <section class="shape-modes shell" aria-labelledby="shape-modes-title">
    <header class="section-intro">
      <h2 id="shape-modes-title">Five real modes, five different jobs.</h2>
      <p>Gold remains Mumble’s brand accent. The application’s mode colours appear here only to identify the real processing form a visitor is reading about.</p>
    </header>
    <div class="shape-mode-ledger">
      {shapeModes.map((mode) => (
        <article data-mode={mode.id}>
          <h3>{mode.label}</h3>
          <p>{mode.summary}</p>
          <small>{mode.boundary}</small>
        </article>
      ))}
    </div>
  </section>

  <section class="journey-next" aria-labelledby="product-next-title">
    <div class="shell journey-next-layout">
      <div>
        <h2 id="product-next-title">Inspect the candidate when the job makes sense.</h2>
        <p>{release.publication.label}. Package facts and every gated platform state remain visible on Downloads.</p>
      </div>
      <div class="journey-next-actions">
        <PlatformAction className="button button-primary" />
        <a class="text-link" href="/downloads/">Release details and all platforms</a>
      </div>
    </div>
  </section>
</BaseLayout>
