---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobStory from '../components/JobStory.astro';
import PlatformAction from '../components/PlatformAction.astro';
import jobs from '../data/jobs.json';
import release from '../data/release.json';

const write = jobs.find((job) => job.id === 'write');
const find = jobs.find((job) => job.id === 'find');
const capture = jobs.find((job) => job.id === 'capture');
const recovery = write?.story?.mechanism.steps.find((step) => step.id === 'recovery');
if (!write?.story) throw new Error('Write story authority is missing');
if (!capture?.story) throw new Error('Capture story authority is missing');
if (!find?.story) throw new Error('Find story authority is missing');
if (!recovery) throw new Error('Write recovery authority is missing');
---

<BaseLayout
  title="Product — How Mumble Write, Capture, and Find work"
  description="Follow Mumble from intended-cursor writing through saved microphone recordings and supported audio imports to Deck retrieval, private local Mumble Find, and separate consent-led Web Search."
  currentPath="/product/"
>
  <section class="page-hero shell" aria-labelledby="product-title">
    <div>
      <h1 id="product-title">Write keeps the destination in the story.</h1>
      <p>{write.summary}</p>
    </div>
    <div class="page-hero-support">
      <p>{write.proof}</p>
      <a class="text-link" href="/use-cases/">See complete Write tasks</a>
    </div>
  </section>

  <JobStory job={write} surface="product" />

  <section class="product-recovery shell" aria-labelledby="recovery-title">
    <figure class="recovery-capture">
      <img
        src="/product/deck-command-surface.webp"
        width="1152"
        height="800"
        loading="lazy"
        alt="Genuine current Mumble Deck capture showing content type tabs for All, Transcripts, Clipboard, Prompts, and Emails, plus Starred, Pin or Unpin, and More command controls"
      />
      <figcaption>
        <strong>Genuine Mumble capture</strong>
        <span>Current accepted Deck command surface; finished results remain available for recovery.</span>
      </figcaption>
    </figure>
    <div>
      <h2 id="recovery-title">A blocked insertion becomes findable material, not a lost result.</h2>
      <p>{recovery.body} Search all Deck content, narrow by type, or filter to Starred material before you copy, paste, or shape it again.</p>
      <a class="button button-quiet" href="/use-cases/#job-find-task-prior-text">Follow complete Find tasks</a>
    </div>
  </section>

  <section class="capture-intro shell" aria-labelledby="capture-product-title">
    <div>
      <h2 id="capture-product-title">Capture keeps the original recording and the working record connected.</h2>
      <p>{capture.summary}</p>
    </div>
    <p>{capture.proof}</p>
  </section>

  <JobStory job={capture} surface="product" />
  <JobStory job={find} surface="product" />

  <section class="journey-next" aria-labelledby="product-next-title">
    <div class="shell journey-next-layout">
      <div>
        <h2 id="product-next-title">Inspect the candidate when the job makes sense.</h2>
        <p>{release.publication.label}. Package facts and every gated platform state remain visible on Downloads.</p>
      </div>
      <div class="journey-next-actions">
        <PlatformAction className="button button-primary" />
        <a class="text-link" href="/downloads/">Release details and all platforms</a>
      </div>
    </div>
  </section>
</BaseLayout>
