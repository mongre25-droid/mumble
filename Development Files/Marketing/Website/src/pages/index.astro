---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformAction from '../components/PlatformAction.astro';
import JobStory from '../components/JobStory.astro';
import HomeMontage from '../components/HomeMontage.astro';
import jobs from '../data/jobs.json';
import release from '../data/release.json';

const windows = release.platforms.find((platform) => platform.id === 'windows');
const write = jobs.find((job) => job.id === 'write');
const find = jobs.find((job) => job.id === 'find');
const capture = jobs.find((job) => job.id === 'capture');
const shape = jobs.find((job) => job.id === 'shape');
const listen = jobs.find((job) => job.id === 'listen');
if (!windows) throw new Error('Windows release authority is missing');
if (!write?.story) throw new Error('Write story authority is missing');
if (!capture?.story) throw new Error('Capture story authority is missing');
if (!shape?.story) throw new Error('Shape story authority is missing');
if (!listen?.story) throw new Error('Listen story authority is missing');
if (!find?.story) throw new Error('Find story authority is missing');
---

<BaseLayout
  title="Mumble — Turn speech into useful work"
  description="See Mumble write, capture, shape, listen, and find through one local-first voice workspace with explicit online boundaries."
  currentPath="/"
>
  <section class="home-opening shell" aria-labelledby="home-title">
    <header class="home-offer">
      <h1 id="home-title">Speak once. Stop at the field where your words belong.</h1>
      <p>Mumble turns speech into useful work across Write, Capture, Shape, Listen, and Find—with local-first routes and every online boundary named before it is used.</p>
      <div class="hero-actions">
        <PlatformAction className="button button-primary" homePrimary />
        <a class="button button-quiet" href="/downloads/">Release details and all platforms</a>
      </div>
    </header>
    <HomeMontage />
  </section>

  <section class="home-privacy-brief" aria-labelledby="home-privacy-brief-title">
    <div class="shell">
      <h2 id="home-privacy-brief-title">Local by default. Online only by a named choice.</h2>
      <ul>
        <li><strong>Local transcription</strong><span>Recorded audio stays on this computer on the default route.</span></li>
        <li><strong>Optional online routes</strong><span>Cloud transcription, shaping, and Reader speech cross their named provider boundary only when selected.</span></li>
        <li><strong>Local Mumble Find</strong><span>Apps and indexed files stay separate from hosted web results.</span></li>
        <li><strong>Consent-gated Web Search</strong><span>Selected words remain local until Search online is confirmed for the named provider.</span></li>
      </ul>
      <a class="text-link" href="/privacy/">Read every privacy route</a>
    </div>
  </section>

  <section class="write-home-detail shell" aria-labelledby="write-home-title">
    <header class="section-intro">
      <h2 id="write-home-title">Write where the cursor already is.</h2>
      <p>{write.story.opening.summary}</p>
    </header>
    <JobStory job={write} surface="home" />
  </section>

  <section class="capture-intro shell" aria-labelledby="capture-home-title">
    <div>
      <h2 id="capture-home-title">Keep the conversation, not just the memory of it.</h2>
      <p>{capture.story.opening.summary}</p>
    </div>
    <a class="text-link" href="/product/#job-capture-mechanism-title">How Capture works</a>
  </section>

  <JobStory job={capture} surface="home" />

  <section class="jobs-section" id="jobs" aria-labelledby="jobs-title">
    <div class="shell section-intro">
      <h2 id="jobs-title">One workspace, five connected jobs.</h2>
      <p>The same vocabulary carries through every later Mumble page, so the product never turns into a catalogue of unrelated features.</p>
    </div>

    <ol class="job-ledger shell">
      {jobs.map((job, index) => (
        <li id={job.id}>
          <span class="job-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{job.label}</h3>
            <p>{job.summary}</p>
            <small>{job.proof}</small>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="shape-home-section" aria-labelledby="shape-home-title">
    <div class="shell shape-home-layout">
      <header class="section-intro">
        <h2 id="shape-home-title">Finished text can take one more deliberate step.</h2>
        <p>{shape.story.opening.summary}</p>
      </header>
      <JobStory job={shape} surface="home" />
    </div>
  </section>

  <section class="listen-intro shell" aria-labelledby="listen-home-title">
    <div>
      <h2 id="listen-home-title">A listening session should still feel like reading.</h2>
      <p>{listen.story.opening.summary}</p>
    </div>
    <a class="text-link" href="/product/#job-listen-mechanism-title">How Listen works</a>
  </section>

  <JobStory job={listen} surface="home" />

  <section class="find-section" aria-labelledby="find-story-title">
    <div class="shell section-intro">
      <h2 id="find-story-title">Three clear ways back to what you need.</h2>
      <p>{find.story.opening.summary}</p>
    </div>
    <JobStory job={find} surface="home" />
  </section>

  <section class="privacy-section" id="privacy" aria-labelledby="privacy-title">
    <div class="shell privacy-layout">
      <div class="privacy-copy">
        <h2 id="privacy-title">The route is part of the answer.</h2>
        <p>
          Local transcription is the default. Network paths remain named, optional choices rather than a hidden consequence of using the product.
        </p>
      </div>

      <div class="route-ledger" aria-label="Current privacy boundaries">
        <article>
          <span>Recorded audio</span>
          <h3>Local transcription</h3>
          <p>Audio stays on this computer while the default local engine produces text.</p>
          <strong>Default · no account or provider key</strong>
        </article>
        <article>
          <span>Recorded audio</span>
          <h3>Cloud transcription</h3>
          <p>Audio leaves only after the user explicitly selects a configured cloud transcription provider.</p>
          <strong>Optional · provider boundary</strong>
        </article>
        <article>
          <span>Finished text</span>
          <h3>Text shaping</h3>
          <p>Cloud shaping sends finished text—not the recorded audio—only through the deliberately selected route.</p>
          <strong>Optional · external providers may charge</strong>
        </article>
        <article>
          <span>Apps and files</span>
          <h3>Local Mumble Find</h3>
          <p>Local apps and indexed files remain on this computer; hosted results never enter the list.</p>
          <strong>Private on this device</strong>
        </article>
        <article>
          <span>Selected words</span>
          <h3>Web Search</h3>
          <p>The named provider receives only the selected words, and only after the user chooses Search online.</p>
          <strong>Separate · consent-gated online route</strong>
        </article>
      </div>
    </div>
  </section>

  <section class="home-supporting-proof" aria-labelledby="supporting-proof-title">
    <div class="shell section-intro">
      <h2 id="supporting-proof-title">Settings and Stats support the work.</h2>
      <p>These current captures prove configuration and review remain available without competing with the five jobs.</p>
    </div>
    <div class="shell home-supporting-grid">
      <figure>
        <img src="/product/settings.webp" width="1180" height="820" loading="lazy" alt="Genuine Mumble Settings capture showing current route and application controls" />
        <figcaption><strong>Supporting proof · Settings</strong><span>Choose devices, routes, and behaviour deliberately.</span></figcaption>
      </figure>
      <figure>
        <img src="/product/stats.webp" width="1180" height="820" loading="lazy" alt="Genuine Mumble Stats capture showing current local activity review" />
        <figcaption><strong>Supporting proof · Stats</strong><span>Review activity after the work, not as an invented marketing metric.</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="trust-section home-ending" data-home-ending aria-labelledby="trust-title">
    <div class="shell trust-layout">
      <div>
        <h2 id="trust-title">Free and MIT licensed. Honest about what is still gated.</h2>
        <p>
          Mumble is free, MIT licensed, and publishes its source. The local path needs no Mumble account or provider key, and no paid service. Optional providers may require an account, key, credits, or other possible costs under their own terms. The current Windows candidate is hash-bound; macOS, Linux, signing, deployment, and public release remain separate gates.
        </p>
      </div>
      <div class="trust-actions">
        <PlatformAction className="button button-primary" />
        <a class="button button-quiet" href="https://github.com/mongre25-droid/mumble/issues">Get Help in the issue tracker</a>
        <a class="text-link" href="/downloads/">Inspect every download fact</a>
      </div>
    </div>
  </section>
</BaseLayout>
