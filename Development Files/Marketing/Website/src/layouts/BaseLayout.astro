---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  currentPath: string;
  noindex?: boolean;
}

const { title, description, currentPath, noindex = false } = Astro.props;
const siteOrigin = 'https://getmumble.com';
const canonicalURL = new URL(currentPath, siteOrigin).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Mumble',
  url: siteOrigin,
  description: 'The public website for Mumble, a local-first desktop voice workspace.',
  inLanguage: 'en',
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#080806" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mumble" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={`${siteOrigin}/product/home.webp`} />
    <meta property="og:image:width" content="1180" />
    <meta property="og:image:height" content="820" />
    <meta property="og:image:alt" content="Mumble's near-black and gold Home workspace" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteOrigin}/product/home.webp`} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/mumble.png" />
    <link rel="apple-touch-icon" href="/mumble.png" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <!--
      THESIS: One guided five-job workspace makes Mumble's voice-first mechanism visible before the long read; it refuses the generic feature-card launch page.
      OWN-WORLD: Near-black workspace planes, warm text, one gold accent, fine ruled seams, and gold-tinted liquid glass inherit the accepted application without copying another site's trade dress.
      STORY: Understand the voice-first offer, guide or directly choose Write, Capture, Shape, Listen, and Find, inspect their proof and boundaries, then choose a truthful desktop action or Help.
      FIRST VIEWPORT: Compact shell above one voice-first line, release-authority action, and a dominant application-matched stage whose real capture changes with the five-job guide.
      FORM: Application control surface, brief-pinned established world, seed key ISSUE-42-PINNED.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header currentPath={currentPath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
