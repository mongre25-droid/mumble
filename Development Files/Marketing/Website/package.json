{
  "name": "mumble-website",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Mumble public website — Astro-powered static multi-page shell",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "check:release": "node scripts/test-release-contract.mjs && node scripts/check-release.mjs",
    "build": "npm run check:release && astro build",
    "test:release": "node scripts/test-release-contract.mjs",
    "test:help": "npm run build && node scripts/test-help-contract.mjs",
    "install:browser": "playwright install chromium",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "test:browser": "npm run build && node scripts/verify-browser-contract.mjs",
    "verify": "npm run check:release && astro check && astro build && npm run audit:dependencies && node scripts/verify-browser-contract.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^7.0.7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "playwright": "^1.55.1"
  }
}
