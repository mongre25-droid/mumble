# Development reference copy of the root Git ignore policy. The root file is
# still required because this file cannot ignore sibling paths such as Internal/.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
Internal/app/_test_logs/

# Virtual environments (regenerated at install from requirements.txt)
.venv/
venv/
env/

# OS / editor / agent
.DS_Store
Thumbs.db
.claude/
.firecrawl/
*.log

# Local app data / secrets (never committed)
settings.json
*.session

# Mumble.zip IS tracked on purpose — it is a versioned deliverable (README §9).

# Reproducible Linux release artifacts are generated by
# Internal/app/Ports/Linux/build_release.py and published from CI.
Internal/app/Ports/Linux/dist/

# Mission artifacts
mission/

# Bundled llama.cpp binaries (pre-built from ggml-org/llama.cpp releases,
# included in the release zip but not tracked in git to avoid binary bloat)
Internal/app/llama-cpp-bin/
